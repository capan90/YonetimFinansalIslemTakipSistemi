<Window x:Class="YonetimFinansalIslemTakipSistemi.UI.Views.WhatsApp.WhatsAppContactEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Height="360" Width="440"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Assets/AppIcon.ico">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <DockPanel Margin="16">

        <!-- Alt butonlar -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Kaydet" Width="100" Height="30"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding SaveCommand}"
                    IsDefault="True"/>
            <Button Content="İptal" Width="80" Height="30" Margin="8,0,0,0"
                    Style="{StaticResource SecondaryButton}"
                    IsCancel="True"/>
        </StackPanel>

        <!-- Hata mesajı -->
        <TextBlock DockPanel.Dock="Bottom"
                   Text="{Binding ErrorMessage}"
                   Foreground="#C62828" FontSize="11" TextWrapping="Wrap"
                   Margin="0,8,0,0"/>

        <!-- Form -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Ad Soyad *:"
                       VerticalAlignment="Center" Margin="0,0,8,10"/>
            <TextBox   Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"
                       Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Telefon *:"
                       VerticalAlignment="Center" Margin="0,0,8,10"/>
            <TextBox   Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"
                       Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="Örn: 0532 123 45 67 — kayıt +905321234567 olarak normalize edilir"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Firma:"
                       VerticalAlignment="Center" Margin="0,0,8,10"/>
            <TextBox   Grid.Row="2" Grid.Column="1" Margin="0,0,0,10"
                       Text="{Binding Company, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Açıklama:"
                       VerticalAlignment="Top" Margin="0,4,8,10"/>
            <TextBox   Grid.Row="3" Grid.Column="1" Margin="0,0,0,10"
                       Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                       VerticalScrollBarVisibility="Auto"
                       Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>

            <CheckBox  Grid.Row="4" Grid.Column="1" Content="Aktif"
                       IsChecked="{Binding IsActive, Mode=TwoWay}"
                       Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </Grid>

    </DockPanel>
</Window>
