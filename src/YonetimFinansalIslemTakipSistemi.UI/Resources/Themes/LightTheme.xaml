<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Arka Plan ──────────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="Theme.AppBackground"         Color="#F8FAFC"/>
    <SolidColorBrush x:Key="Theme.Surface"               Color="White"/>
    <SolidColorBrush x:Key="Theme.CardBackground"        Color="White"/>

    <!-- ── Marka ──────────────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="Theme.Primary"               Color="#1E3A5F"/>
    <SolidColorBrush x:Key="Theme.PrimaryHover"          Color="#2E5F9F"/>

    <!-- ── Metin ──────────────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="Theme.Text"                  Color="#1A202C"/>
    <!-- MutedText yalnızca DEKORATİF soluk metin içindir (ipucu, zaman damgası).
         Beyaz üzerinde 4.6:1 — AA'yı geçer ama etiket/başlık için zayıf kalır. -->
    <SolidColorBrush x:Key="Theme.MutedText"             Color="#64748B"/>
    <!-- Etiket/başlık rolündeki ikincil metin: beyaz üzerinde 7.4:1 (AAA).
         Kart etiketleri, form etiketleri ve sütun başlıkları bunu kullanır. -->
    <SolidColorBrush x:Key="Theme.LabelText"             Color="#475569"/>

    <!-- ── Devre dışı ─────────────────────────────────────────────────────────── -->
    <!-- Beyaz metinle 5.26:1 (AA). Eski #94A3B8 + Opacity 0.7 kombinasyonu 2.1:1'e,
         Faz B'deki #64748B ise 4.34:1'e düşüyordu — ikisi de AA'nın altındaydı. -->
    <SolidColorBrush x:Key="Theme.DisabledBackground"    Color="#616D7D"/>

    <!-- ── Kenarlık / Input ───────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="Theme.Border"                Color="#E2E8F0"/>
    <SolidColorBrush x:Key="Theme.InputBackground"       Color="White"/>
    <SolidColorBrush x:Key="Theme.InputBorder"           Color="#CBD5E1"/>
    <SolidColorBrush x:Key="Theme.InputBorderFocus"      Color="#1E3A5F"/>

    <!-- ── DataGrid ───────────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="Theme.DataGridHeader"        Color="#F1F5F9"/>
    <SolidColorBrush x:Key="Theme.DataGridHeaderText"    Color="#1E3A5F"/>
    <SolidColorBrush x:Key="Theme.DataGridRow"           Color="White"/>
    <SolidColorBrush x:Key="Theme.DataGridAltRow"        Color="#F8FAFC"/>
    <SolidColorBrush x:Key="Theme.DataGridSelectedRow"   Color="#DBEAFE"/>
    <SolidColorBrush x:Key="Theme.DataGridSelectedText"  Color="#1A202C"/>
    <SolidColorBrush x:Key="Theme.DataGridHoverRow"      Color="#EFF6FF"/>

    <!-- ── Durum ──────────────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="Theme.Danger"                Color="#C62828"/>
    <SolidColorBrush x:Key="Theme.Success"               Color="#2E7D32"/>
    <SolidColorBrush x:Key="Theme.Warning"               Color="#D97706"/>

    <!-- ══ DURUM RENKLERİ (dört adımlı) ══════════════════════════════════════
         Her durum için aynı dört rol:
           Background        yumuşak panel/şerit dolgusu
           BackgroundStrong  rozet dolgusu (panelden bir tık doygun)
           Border            panel kenarlığı
           Text              dolgu üzerinde okunan koyu metin (her zaman 7:1+)

         Dolu renk üzerine beyaz metin deseni terk edildi — listede ~1.9:1 veriyordu.
    ═══════════════════════════════════════════════════════════════════════ -->

    <!-- Bilgi / nötr vurgu -->
    <SolidColorBrush x:Key="Theme.Info.Background"         Color="#EFF6FF"/>
    <SolidColorBrush x:Key="Theme.Info.BackgroundStrong"   Color="#DBEAFE"/>
    <SolidColorBrush x:Key="Theme.Info.Border"             Color="#B0C4F0"/>
    <SolidColorBrush x:Key="Theme.Info.Text"               Color="#1E40AF"/>

    <!-- Başarı / olumlu -->
    <SolidColorBrush x:Key="Theme.Success.Background"      Color="#F0FDF4"/>
    <SolidColorBrush x:Key="Theme.Success.BackgroundStrong" Color="#DCFCE7"/>
    <SolidColorBrush x:Key="Theme.Success.Border"          Color="#86EFAC"/>
    <SolidColorBrush x:Key="Theme.Success.Text"            Color="#166534"/>

    <!-- Uyarı / dikkat -->
    <SolidColorBrush x:Key="Theme.Warning.Background"      Color="#FFF7ED"/>
    <SolidColorBrush x:Key="Theme.Warning.BackgroundStrong" Color="#FFEDD5"/>
    <SolidColorBrush x:Key="Theme.Warning.Border"          Color="#FED7AA"/>
    <SolidColorBrush x:Key="Theme.Warning.Text"            Color="#9A3412"/>

    <!-- Hata / kritik -->
    <SolidColorBrush x:Key="Theme.Danger.Background"       Color="#FEF2F2"/>
    <SolidColorBrush x:Key="Theme.Danger.BackgroundStrong" Color="#FEE2E2"/>
    <SolidColorBrush x:Key="Theme.Danger.Border"           Color="#FECDD3"/>
    <SolidColorBrush x:Key="Theme.Danger.Text"             Color="#991B1B"/>

    <!-- Kritik — Danger'dan bir kademe yukarısı. Sistem log seviyeleri dört
         basamaklıdır (Info < Warning < Error < Critical); Faz B'de Critical'ın
         kendi rol seti yoktu ve Error ile aynı görünüyordu.
         Tek dolu (solid) seviye budur: dolgu üzerinde beyaz metin 5.6:1. -->
    <SolidColorBrush x:Key="Theme.Critical.Background"       Color="#FEE2E2"/>
    <SolidColorBrush x:Key="Theme.Critical.BackgroundStrong" Color="#C62828"/>
    <SolidColorBrush x:Key="Theme.Critical.Border"           Color="#991B1B"/>
    <SolidColorBrush x:Key="Theme.Critical.Text"             Color="#FFFFFF"/>

    <!-- Mor vurgu — bildirim/rehber gibi "ikincil bilgi" şeritleri -->
    <SolidColorBrush x:Key="Theme.Accent.Background"       Color="#F5F3FF"/>
    <SolidColorBrush x:Key="Theme.Accent.BackgroundStrong" Color="#EDE9FE"/>
    <SolidColorBrush x:Key="Theme.Accent.Border"           Color="#DDD6FE"/>
    <SolidColorBrush x:Key="Theme.Accent.Text"             Color="#5B21B6"/>

    <!-- ── Buton metin renkleri ("on-" rolleri) ───────────────────────────────
         Buton yazısı beyaza sabitlenemez: koyu temada Primary açık maviye,
         Danger açık kırmızıya dönüyor ve beyaz metin 2.5:1'e düşüyordu.
         Zemin token'ıyla birlikte metin token'ı da temaya bağlı olmalı. -->
    <SolidColorBrush x:Key="Theme.OnPrimary"             Color="White"/>
    <SolidColorBrush x:Key="Theme.OnSecondary"           Color="White"/>
    <SolidColorBrush x:Key="Theme.OnDanger"              Color="White"/>
    <SolidColorBrush x:Key="Theme.OnDisabled"            Color="White"/>

    <!-- ── Buton durumları ────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="Theme.PrimaryPressed"        Color="#152C4A"/>
    <SolidColorBrush x:Key="Theme.Secondary"             Color="#475569"/>
    <SolidColorBrush x:Key="Theme.SecondaryHover"        Color="#334155"/>
    <SolidColorBrush x:Key="Theme.SecondaryPressed"      Color="#1E293B"/>
    <SolidColorBrush x:Key="Theme.DangerHover"           Color="#B71C1C"/>
    <SolidColorBrush x:Key="Theme.DangerPressed"         Color="#7F1010"/>

    <!-- ── Navigasyon şeridi (Kargo Dashboard) ──────────────────────────────
         Navigasyon şeridi her iki temada da KOYU kalır: marka bandıdır, yüzey
         değildir. Bu yüzden metni sabit açık uçtan gelir. -->
    <SolidColorBrush x:Key="Theme.Nav.Background"        Color="#1E3A5F"/>
    <SolidColorBrush x:Key="Theme.Nav.ItemBackground"    Color="#2E5F9F"/>
    <SolidColorBrush x:Key="Theme.Nav.ItemBorder"        Color="#3B7BC8"/>
    <SolidColorBrush x:Key="Theme.Nav.Foreground"        Color="White"/>
    <!-- Beyaz metinle 5.45:1. Eski #3B7BC8 4.33 veriyordu — AA'nın altında. -->
    <SolidColorBrush x:Key="Theme.Nav.HoverBackground"   Color="#2F6BB0"/>
    <SolidColorBrush x:Key="Theme.Nav.HoverForeground"   Color="White"/>
    <SolidColorBrush x:Key="Theme.Nav.ActiveBackground"  Color="#5391D6"/>
    <SolidColorBrush x:Key="Theme.Nav.ActiveForeground"  Color="#0B1B2E"/>

    <!-- ── Gölge ──────────────────────────────────────────────────────────────
         DropShadowEffect.Color bir Brush değil Color alır; bu yüzden fırça değil
         Color kaynağı olarak tanımlanır. DynamicResource yine çalışır. -->
    <Color x:Key="Theme.ShadowColor">#CBD5E1</Color>

    <!-- ── Yüzey kademeleri ───────────────────────────────────────────────── -->
    <!-- SurfaceAlt: araç çubuğu / alt şerit gibi hafif ayrışan alanlar -->
    <SolidColorBrush x:Key="Theme.SurfaceAlt"            Color="#F1F5F9"/>
    <!-- SurfaceSubtle: salt okunur alan, devre dışı input zemini -->
    <SolidColorBrush x:Key="Theme.SurfaceSubtle"         Color="#F8FAFC"/>

    <!-- ══ MENÜ ══════════════════════════════════════════════════════════════
         WPF'in varsayılan MenuItem stili Foreground'u #212121'e SABİTLER (stil
         setter'ı, miras değil). Koyu temada menü zemini koyulaşırken metin koyu
         kalıyor ve "Yönetim / Ayarlar / Yardım" görünmez oluyordu.
         Menü artık kendi rol setini kullanır; şablonlar Controls.xaml'de. -->
    <SolidColorBrush x:Key="Theme.Menu.Background"          Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Theme.Menu.Foreground"          Color="#1A202C"/>
    <SolidColorBrush x:Key="Theme.Menu.HoverBackground"     Color="#E2E8F0"/>
    <SolidColorBrush x:Key="Theme.Menu.HoverForeground"     Color="#1A202C"/>
    <SolidColorBrush x:Key="Theme.Menu.SelectedBackground"  Color="#DBEAFE"/>
    <SolidColorBrush x:Key="Theme.Menu.SelectedForeground"  Color="#1E40AF"/>
    <SolidColorBrush x:Key="Theme.Menu.DisabledForeground"  Color="#6B7688"/>
    <SolidColorBrush x:Key="Theme.Menu.Separator"           Color="#E2E8F0"/>

    <!-- ══ POPUP ═════════════════════════════════════════════════════════════
         Popup/ContextMenu ayrı bir visual tree'de yaşar; pencerenin Background
         ve Foreground'unu MİRAS ALMAZ. Kendi zemin/metin rolü olmak zorunda. -->
    <SolidColorBrush x:Key="Theme.Popup.Background"         Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Theme.Popup.Foreground"         Color="#1A202C"/>
    <SolidColorBrush x:Key="Theme.Popup.Border"             Color="#CBD5E1"/>

    <!-- ══ INPUT ek rolleri ══════════════════════════════════════════════════
         Zemin/kenarlık için mevcut Theme.InputBackground / InputBorder /
         InputBorderFocus kullanılmaya devam eder; aşağıdakiler Faz B'de hiç
         tanımlanmamış olan durumlardır. Seçim rengi tanımlı olmadığı için
         TextBox'ta yazılan metin seçilince sistem mavisi + koyu metin
         çakışıyor ve metin kayboluyordu. -->
    <SolidColorBrush x:Key="Theme.Input.Placeholder"          Color="#64748B"/>
    <SolidColorBrush x:Key="Theme.Input.DisabledBackground"   Color="#F1F5F9"/>
    <SolidColorBrush x:Key="Theme.Input.DisabledForeground"   Color="#596579"/>
    <SolidColorBrush x:Key="Theme.Input.ReadOnlyBackground"   Color="#F8FAFC"/>
    <SolidColorBrush x:Key="Theme.Input.SelectionBackground"  Color="#1E3A5F"/>
    <SolidColorBrush x:Key="Theme.Input.SelectionForeground"  Color="#FFFFFF"/>

    <!-- ══ COMBOBOX ══════════════════════════════════════════════════════════
         Kapalı kutu ile açılır liste AYRI yüzeylerdir. WPF varsayılanında
         açılır liste SystemColors.WindowBrush (beyaz) iken item metni
         ComboBox'tan miras alınıyordu → koyu temada beyaz üstüne beyaz. -->
    <SolidColorBrush x:Key="Theme.ComboBox.DropdownBackground"     Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Theme.ComboBox.DropdownForeground"     Color="#1A202C"/>
    <SolidColorBrush x:Key="Theme.ComboBox.ItemHoverBackground"    Color="#EFF6FF"/>
    <SolidColorBrush x:Key="Theme.ComboBox.ItemHoverForeground"    Color="#1A202C"/>
    <SolidColorBrush x:Key="Theme.ComboBox.ItemSelectedBackground" Color="#DBEAFE"/>
    <SolidColorBrush x:Key="Theme.ComboBox.ItemSelectedForeground" Color="#1E40AF"/>

    <!-- ══ NÖTR BUTON ════════════════════════════════════════════════════════
         Uygulamadaki 149 butonun ~50'si Primary/Secondary/Danger stillerinden
         hiçbirini kullanmıyor; WPF varsayılan şablonuna düşüyorlardı. O şablon
         sabit açık gri gradyan + koyu metindir ve tema değişimini görmez. -->
    <SolidColorBrush x:Key="Theme.Button.Background"         Color="#F1F5F9"/>
    <SolidColorBrush x:Key="Theme.Button.Foreground"         Color="#1A202C"/>
    <SolidColorBrush x:Key="Theme.Button.Border"             Color="#CBD5E1"/>
    <SolidColorBrush x:Key="Theme.Button.HoverBackground"    Color="#E2E8F0"/>
    <SolidColorBrush x:Key="Theme.Button.PressedBackground"  Color="#CBD5E1"/>
    <SolidColorBrush x:Key="Theme.Button.DisabledBackground" Color="#F1F5F9"/>
    <!-- Devre dışı metin WCAG'den muaftır; yine de en az 3:1 hedeflenir (4.19:1) -->
    <SolidColorBrush x:Key="Theme.Button.DisabledForeground" Color="#6B7688"/>
    <SolidColorBrush x:Key="Theme.Button.DisabledBorder"     Color="#E2E8F0"/>

    <!-- ══ TOOLTIP ═══════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="Theme.ToolTip.Background"        Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Theme.ToolTip.Foreground"        Color="#1A202C"/>
    <SolidColorBrush x:Key="Theme.ToolTip.Border"            Color="#CBD5E1"/>

    <!-- ══ KAYDIRMA ÇUBUĞU ═══════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="Theme.ScrollBar.Track"           Color="#F1F5F9"/>
    <SolidColorBrush x:Key="Theme.ScrollBar.Thumb"           Color="#CBD5E1"/>
    <SolidColorBrush x:Key="Theme.ScrollBar.ThumbHover"      Color="#94A3B8"/>

    <!-- ══ RAPOR ÖNİZLEME / BASKI KATMANI ════════════════════════════════════
         BU DEĞERLER İKİ TEMADA DA AYNIDIR — bilinçli olarak.
         Yazdırılacak kâğıt ve üzerindeki metin, ekran temasından bağımsızdır:
         çıktı her zaman beyaz kâğıda siyah mürekkeple basılır. Uygulama teması
         koyuya dönünce önizlemenin de kararması, kullanıcıya yanlış bir baskı
         çıktısı vaat eder. Bu yüzden rapor gövdesi Theme.Surface / Theme.Text
         gibi dinamik token'lara BAĞLANMAZ.
         PDF/Excel üretimi zaten kendi sabit renklerini kullanır; bu blok yalnızca
         önizlemenin o çıktıyla aynı görünmesini sağlar. -->
    <SolidColorBrush x:Key="Theme.PrintPreview.PaperBackground"    Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Theme.PrintPreview.Text"               Color="#111827"/>
    <SolidColorBrush x:Key="Theme.PrintPreview.MutedText"          Color="#4B5563"/>
    <SolidColorBrush x:Key="Theme.PrintPreview.Border"             Color="#D1D5DB"/>
    <SolidColorBrush x:Key="Theme.PrintPreview.HeaderBackground"   Color="#F3F4F6"/>
    <SolidColorBrush x:Key="Theme.PrintPreview.AltRow"             Color="#F9FAFB"/>
    <SolidColorBrush x:Key="Theme.PrintPreview.SelectedBackground" Color="#DBEAFE"/>
    <SolidColorBrush x:Key="Theme.PrintPreview.SelectedText"       Color="#111827"/>
    <!-- Baskıda okunan koyu yeşil/kırmızı — ekrandaki Theme.Success/Danger DEĞİL -->
    <SolidColorBrush x:Key="Theme.PrintPreview.Positive"           Color="#14532D"/>
    <SolidColorBrush x:Key="Theme.PrintPreview.Negative"           Color="#7F1D1D"/>

    <!-- ══ GRAFİK PALETİ (Faz C) ═════════════════════════════════════════════
         Yalnızca VERİ renkleri burada. Eksen, ızgara, legend ve tooltip gibi
         grafik kromu mevcut Theme.* rollerini kullanır (bkz. Common/ChartPalette.cs)
         — ikinci bir gri seti tanımlamanın anlamı yok.

         Grafikler SkiaSharp ile çizilir ve DynamicResource'u GÖRMEZ. Bu token'lar
         ChartPalette.cs tarafından okunup SolidColorPaint'e çevrilir; tema
         değiştiğinde seriler yeniden boyanır.

         Eşik: grafik işaretleri için 3:1 (WCAG non-text contrast).
    ═══════════════════════════════════════════════════════════════════════ -->

    <!-- Kategorik seriler — SIRAYLA kullanılır, döngüye sokulmaz, dördüncüsü yoktur.
         Üçten fazla kategori varsa renk eklenmez; küçükler "Diğer" altında toplanır.
         Beyaz yüzeyde: mavi 4.42:1, turuncu 3.20:1, yeşil 4.09:1.
         Yeşil bilinçli olarak #1BAF7A'dan koyulaştırıldı — o değer 2.82:1 ile
         eşiğin altındaydı ve ince çizgi serilerinde kayboluyordu. -->
    <SolidColorBrush x:Key="Chart.Series1"            Color="#2A78D6"/>
    <SolidColorBrush x:Key="Chart.Series2"            Color="#EB6834"/>
    <SolidColorBrush x:Key="Chart.Series3"            Color="#128F63"/>

    <!-- Yön gösteren veri (borç/alacak, giriş/çıkış).
         Kırmızı/yeşil KULLANILMAZ: renk körlüğünde en zayıf eksendir.
         Mavi–turuncu çifti hem renk körlüğünde hem gri baskıda ayrışır. -->
    <SolidColorBrush x:Key="Chart.Direction.Inflow"   Color="#2A78D6"/>
    <SolidColorBrush x:Key="Chart.Direction.Outflow"  Color="#EB6834"/>

    <!-- Tek boyutlu büyüklük verisi (Durum Dağılımı, Top 5 Firma).
         Burada renk KİMLİK değil BÜYÜKLÜK taşır → kategorik palet kullanılmaz,
         tek hue'nun açık→koyu adımları kullanılır.
         Skalanın açık ucu doğası gereği düşük kontrastlıdır (1.5:1); büyüklüğü
         zaten bar UZUNLUĞU taşır. Görünürlük Chart.Sequential.Stroke kenarlığıyla
         sağlanır — dolgunun tek başına eşiği tutması beklenmez. -->
    <SolidColorBrush x:Key="Chart.Sequential.1"       Color="#DCE9F9"/>
    <SolidColorBrush x:Key="Chart.Sequential.2"       Color="#A9C7EE"/>
    <SolidColorBrush x:Key="Chart.Sequential.3"       Color="#6FA3E4"/>
    <SolidColorBrush x:Key="Chart.Sequential.4"       Color="#2A78D6"/>
    <SolidColorBrush x:Key="Chart.Sequential.5"       Color="#1C5399"/>
    <SolidColorBrush x:Key="Chart.Sequential.Stroke"  Color="#475569"/>

    <!-- Bakiye kartı sparkline'ı — tek seri, kimlik taşımaz -->
    <SolidColorBrush x:Key="Chart.Sparkline"          Color="#2A78D6"/>

    <!-- ── Sistem: DataGrid seçim rengi override ──────────────────────────────── -->
    <!-- WPF sistem renkleri DynamicResource yerine statik x:Static key ile override edilir -->
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                     Color="#DBEAFE"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                     Color="#1A202C"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                     Color="#DBEAFE"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}"
                     Color="#1A202C"/>

    <!-- ── Sistem: geri kalan WPF varsayılan şablonları ───────────────────────
         Kendi şablonunu yazmadığımız kontroller (Calendar, DatePicker takvimi,
         ContextMenu iç parçaları, ScrollViewer köşesi) bu anahtarlara bakar.
         Açık temada değerler zaten Windows varsayılanıyla aynı — bu blok
         DarkTheme.xaml'deki karşılığının parite eşidir. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}"      Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}"  Color="#1A202C"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}"     Color="#F1F5F9"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#1A202C"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}"    Color="#6B7688"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}"        Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}"    Color="#1A202C"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoBrushKey}"        Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoTextBrushKey}"    Color="#1A202C"/>

</ResourceDictionary>
