<UserControl x:Class="YonetimFinansalIslemTakipSistemi.UI.Views.Cargo.CargoShipmentListScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:common="clr-namespace:YonetimFinansalIslemTakipSistemi.UI.Common"
             Background="{DynamicResource Theme.AppBackground}">

    <!-- Klavye kısayolları — mevcut Click handler'ları sarmalayıcı ile çağrılır.
         Enter bilinçli olarak pencere değil DataGrid seviyesinde: arama kutusundaki
         Enter zaten aramayı çalıştırıyor, ikisi çakışmamalı. -->
    <UserControl.CommandBindings>
        <CommandBinding Command="common:AppCommands.New"            Executed="Command_New"/>
        <CommandBinding Command="common:AppCommands.Duplicate"      Executed="Command_Duplicate"/>
        <CommandBinding Command="common:AppCommands.DeleteSelected" Executed="Command_Delete"/>
        <CommandBinding Command="common:AppCommands.EditSelected"   Executed="Command_Edit"/>
        <CommandBinding Command="common:AppCommands.RefreshList"    Executed="Command_Refresh"/>
        <CommandBinding Command="common:AppCommands.FocusSearch"    Executed="Command_FocusSearch"/>
        <CommandBinding Command="common:AppCommands.CloseWindow"    Executed="Command_Close"/>
    </UserControl.CommandBindings>
    <UserControl.InputBindings>
        <KeyBinding Key="N"      Modifiers="Ctrl" Command="common:AppCommands.New"/>
        <KeyBinding Key="D"      Modifiers="Ctrl" Command="common:AppCommands.Duplicate"/>
        <KeyBinding Key="Delete"                  Command="common:AppCommands.DeleteSelected"/>
        <KeyBinding Key="F5"                      Command="common:AppCommands.RefreshList"/>
        <KeyBinding Key="F"      Modifiers="Ctrl" Command="common:AppCommands.FocusSearch"/>
        <KeyBinding Key="Escape"                  Command="common:AppCommands.CloseWindow"/>
    </UserControl.InputBindings>

    <DockPanel Margin="8">

        <!-- Başlık satırı -->
        <TextBlock x:Name="TitleBlock" DockPanel.Dock="Top"
                   Style="{StaticResource Text.H2}"
                   Margin="0,0,0,6"/>

        <!-- Araç çubuğu — 1. satır: CRUD + Arama + Filtreler -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <!-- Visibility: UI gizlemesi; asıl koruma handler seviyesindedir -->
                <Button x:Name="NewButton"    Content="+ Yeni"  Width="70"  Margin="0,0,6,0"
                        Style="{StaticResource PrimaryButton}"
                        Click="NewButton_Click"/>
                <Button x:Name="CopyButton"   Content="Kopyala" Width="75"  Margin="0,0,6,0"
                        Style="{StaticResource SecondaryButton}"
                        IsEnabled="{Binding HasSelected}" Click="CopyButton_Click"
                        ToolTip="Seçili kaydı şablon olarak kullanarak yeni kargo formu açar"/>
                <Button x:Name="EditButton"   Content="Düzenle" Width="75"  Margin="0,0,6,0"
                        Style="{StaticResource SecondaryButton}"
                        IsEnabled="{Binding HasSelected}" Click="EditButton_Click"/>
                <Button x:Name="DeleteButton" Content="Sil"     Width="60"
                        Style="{StaticResource DangerButton}"
                        IsEnabled="{Binding HasSelected}" Click="DeleteButton_Click"/>
                <Button Content="Yenile" Width="65" Margin="6,0,0,0"
                        Style="{StaticResource SecondaryButton}"
                        Click="RefreshButton_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <!-- Arama türü seçici -->
                <ComboBox ItemsSource="{Binding SearchTypeOptions}"
                          SelectedItem="{Binding SelectedSearchType, Mode=TwoWay}"
                          Width="110" Margin="0,0,4,0"
                          ToolTip="Arama yapılacak alanı seçin"/>
                <TextBox x:Name="SearchBox"
                         Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                         Width="180" Margin="0,0,6,0" KeyDown="SearchBox_KeyDown"
                         ToolTip="Seçili arama türünde ara — Enter veya Ara butonu ile (Ctrl+F)"/>
                <Button Content="Ara" Width="55" Margin="0,0,12,0"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding SearchCommand}"/>
                <ComboBox ItemsSource="{Binding StatusFilterOptions}"
                          SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}"
                          Width="130" Margin="0,0,6,0"
                          SelectionChanged="StatusFilter_SelectionChanged"
                          ToolTip="Kargo durumuna göre filtrele"/>
                <ComboBox ItemsSource="{Binding PriorityFilterOptions}"
                          SelectedItem="{Binding SelectedPriorityFilter, Mode=TwoWay}"
                          Width="110"
                          SelectionChanged="PriorityFilter_SelectionChanged"
                          ToolTip="Önceliğe göre filtrele"/>
            </StackPanel>
        </DockPanel>

        <!-- Araç çubuğu — 2. satır: Operasyon + Excel içe aktarma -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
            <Button x:Name="OperationButton"
                    Width="125" Margin="0,0,0,0"
                    Style="{StaticResource SecondaryButton}"
                    IsEnabled="{Binding HasSelected}"
                    Click="OperationButton_Click"
                    ToolTip="Seçili kargo için operasyon merkezini açar: Etiket, WhatsApp, Mail, Takip, Durum Değiştir">
                <StackPanel Style="{StaticResource IconTextPanel}">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Bolt}" Margin="0,0,6,0"/>
                    <TextBlock Text="Operasyon"/>
                </StackPanel>
            </Button>
            <Button x:Name="ImportButton"
                    Width="170" Margin="8,0,0,0"
                    Style="{StaticResource SecondaryButton}"
                    Click="ImportButton_Click"
                    ToolTip="Excel dosyasından toplu kargo kaydı oluşturur: analiz → önizleme → onay → içe aktarma">
                <StackPanel Style="{StaticResource IconTextPanel}">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Download}" Margin="0,0,6,0"/>
                    <TextBlock Text="Excel'den İçe Aktar"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Liste + boş durum mesajı -->
        <Grid>
        <DataGrid x:Name="MainGrid"
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding Selected, Mode=TwoWay}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" CanUserAddRows="False"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource Theme.Border}"
                  AlternatingRowBackground="{DynamicResource Theme.DataGridAltRow}"
                  RowBackground="{DynamicResource Theme.DataGridRow}"
                  BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1"
                  MouseDoubleClick="MainGrid_MouseDoubleClick">
            <!-- Enter yalnızca ızgara odaktayken düzenler; arama kutusundaki
                 Enter aramayı çalıştırmaya devam eder -->
            <DataGrid.InputBindings>
                <KeyBinding Key="Enter" Command="common:AppCommands.EditSelected"/>
            </DataGrid.InputBindings>
            <DataGrid.Columns>
                <!-- Öncelik rozeti: yumuşak dolgu + koyu metin.
                     Normal öncelik çoğunluktur — rozet çizilmez, sade metin kalır;
                     böylece gerçekten acil olan satırlar listede öne çıkar. -->
                <DataGridTemplateColumn Header="Öncelik" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="3" Padding="6,1" HorizontalAlignment="Left">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <!-- Normal: dolgu yok -->
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PriorityDisplay}" Value="Orta">
                                                <Setter Property="Background" Value="{DynamicResource Theme.Info.BackgroundStrong}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PriorityDisplay}" Value="Acil">
                                                <Setter Property="Background" Value="{DynamicResource Theme.Warning.BackgroundStrong}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PriorityDisplay}" Value="Çok Acil">
                                                <Setter Property="Background" Value="{DynamicResource Theme.Danger.BackgroundStrong}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <!-- "!" yalnızca Çok Acil'de: renge ek ikinci bir sinyal,
                                         renk körlüğünde de ayırt edilebilsin -->
                                    <TextBlock Text="!" FontWeight="Bold"
                                               Margin="0,0,3,0"
                                               Foreground="{DynamicResource Theme.Danger.Text}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PriorityDisplay}" Value="Çok Acil">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding PriorityDisplay}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                                <Setter Property="Foreground" Value="{DynamicResource Theme.LabelText}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PriorityDisplay}" Value="Orta">
                                                        <Setter Property="Foreground" Value="{DynamicResource Theme.Info.Text}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PriorityDisplay}" Value="Acil">
                                                        <Setter Property="Foreground" Value="{DynamicResource Theme.Warning.Text}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PriorityDisplay}" Value="Çok Acil">
                                                        <Setter Property="Foreground" Value="{DynamicResource Theme.Danger.Text}"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Kargo No"
                                    Binding="{Binding ShipmentNumber}"
                                    Width="120"
                                    ElementStyle="{StaticResource EllipsisCell}"/>
                <DataGridTextColumn Header="Tarih"
                                    Binding="{Binding ShipmentDate, StringFormat=dd.MM.yyyy}"
                                    Width="85"
                                    ElementStyle="{StaticResource EllipsisCell}"/>
                <DataGridTextColumn Header="Kargo Firması"
                                    Binding="{Binding CargoCompanyName}"
                                    Width="120"
                                    ElementStyle="{StaticResource EllipsisCell}"/>
                <DataGridTextColumn Header="Karşı Taraf"
                                    Binding="{Binding DisplayParty}"
                                    Width="150"
                                    ElementStyle="{StaticResource EllipsisCell}"/>
                <!-- Çoğu kayıtta boş: sabit genişlik yerine içeriğe göre daralsınlar -->
                <DataGridTextColumn Header="Takip No"
                                    Binding="{Binding TrackingNumber}"
                                    Width="Auto" MinWidth="80"
                                    ElementStyle="{StaticResource EllipsisCell}"/>
                <DataGridTextColumn Header="Araç Plaka"
                                    Binding="{Binding VehiclePlate}"
                                    Width="Auto" MinWidth="80"
                                    ElementStyle="{StaticResource EllipsisCell}"/>

                <!-- Tek bağlantı kaynağı: firma PortalUrl (eski kayıtlarda saklı TrackingUrl korunur);
                     DTO seviyesinde birleştirilir -->
                <DataGridTemplateColumn Header="Portal / Takip" Width="85">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TrackingUrl}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding TrackingUrl}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                                <Hyperlink NavigateUri="{Binding TrackingUrl}"
                                           RequestNavigate="TrackingUrl_RequestNavigate">
                                    Takip Et
                                </Hyperlink>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Durum"
                                    Binding="{Binding StatusDisplay}"
                                    Width="100"
                                    ElementStyle="{StaticResource EllipsisCell}"/>
                <DataGridTextColumn Header="Bildirim Durumu"
                                    Binding="{Binding NotificationStatusDisplay}"
                                    Width="110"
                                    ElementStyle="{StaticResource EllipsisCell}"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="Gösterilecek kargo kaydı bulunamadı">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateText}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Items.Count, ElementName=MainGrid}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        </Grid>

    </DockPanel>
</UserControl>
