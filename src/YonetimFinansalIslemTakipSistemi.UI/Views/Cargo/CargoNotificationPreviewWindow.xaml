<Window x:Class="YonetimFinansalIslemTakipSistemi.UI.Views.Cargo.CargoNotificationPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bildirim Hazırla" Width="580" Height="660"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanMinimize"
        Icon="pack://application:,,,/Assets/AppIcon.ico">

    <DockPanel Margin="14">

        <!-- Başlık — code-behind tarafından mode'a göre güncellenir -->
        <TextBlock x:Name="TitleBlock"
                   DockPanel.Dock="Top"
                   Style="{StaticResource Text.Body}" FontWeight="SemiBold"
                   Margin="0,0,0,10"/>

        <!-- Kargo özet bilgisi: her iki modda görünür -->
        <Border DockPanel.Dock="Top"
                Background="#F0FFF0" BorderBrush="#A8D8A8" BorderThickness="1"
                CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="75"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="75"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Kargo No | Alıcı Firma -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Kargo No:" FontWeight="SemiBold" Margin="0,0,6,4"/>
                <TextBlock Grid.Row="0" Grid.Column="1"
                           x:Name="ShipmentNumberBlock" Margin="0,0,12,4"/>
                <TextBlock Grid.Row="0" Grid.Column="2"
                           Text="Alıcı Firma:" FontWeight="SemiBold" Margin="0,0,6,4"/>
                <TextBlock Grid.Row="0" Grid.Column="3"
                           x:Name="ReceiverBlock" Margin="0,0,0,4"
                           TextTrimming="CharacterEllipsis"/>

                <!-- Telefon — yalnızca WhatsApp modunda görünür.
                     Rehberden kişi seçiliyken salt okunurdur; düzeltme WhatsApp Rehberi ekranından yapılır -->
                <TextBlock Grid.Row="1" Grid.Column="0"
                           x:Name="PhoneLabelBlock"
                           Text="Telefon:" FontWeight="SemiBold" Margin="0,0,6,0"
                           Visibility="Collapsed"/>
                <TextBox   Grid.Row="1" Grid.Column="1"
                           x:Name="PhoneTextBox"
                           Grid.ColumnSpan="3" Margin="0,0,0,0"
                           Padding="4,2" BorderThickness="1" BorderBrush="#CBD5E1"
                           Visibility="Collapsed"
                           ToolTip="WhatsApp alıcı numarası — yalnızca bu gönderim için kullanılır"/>
            </Grid>
        </Border>

        <!-- WhatsApp rehber seçimi — yalnızca WhatsApp modunda görünür -->
        <Border x:Name="ContactsPanel"
                DockPanel.Dock="Top"
                Background="#F8F9FA" BorderBrush="#CBD5E1" BorderThickness="1"
                CornerRadius="4" Padding="10,8" Margin="0,0,0,8"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Rehberden Alıcı Seç" FontWeight="SemiBold"
                           Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>

                <DockPanel Margin="0,0,0,2">
                    <!-- Padding=0 zorunlu: SecondaryButton stilinin 14px yatay padding'i
                         dar butonda '+' işaretini tamamen kırpıyordu -->
                    <Button x:Name="AddContactButton"
                            DockPanel.Dock="Right"
                            Content="+" Width="32" Height="26" Margin="6,0,0,0"
                            Padding="0" FontSize="16" FontWeight="Bold"
                            Style="{StaticResource SecondaryButton}"
                            Click="AddContactButton_Click"
                            ToolTip="Yeni WhatsApp kişisi ekle"/>
                    <Button x:Name="DropDownButton"
                            DockPanel.Dock="Right"
                            Content="▼" Width="26" Height="26" Margin="4,0,0,0"
                            Padding="0" FontSize="12"
                            Style="{StaticResource SecondaryButton}"
                            Click="DropDownButton_Click"
                            ToolTip="Rehber listesini aç"/>
                    <TextBox x:Name="ContactSearchBox"
                             Height="26" VerticalContentAlignment="Center"
                             Padding="4,2" BorderThickness="1" BorderBrush="#CBD5E1"
                             TextChanged="ContactSearchBox_TextChanged"
                             GotKeyboardFocus="ContactSearchBox_GotKeyboardFocus"
                             ToolTip="Ad, firma veya telefonla arayın — yazınca liste açılır"/>
                </DockPanel>

                <!-- Kişi listesi: sürekli açık durmaz; arama alanına odaklanınca/yazınca veya
                     ▼ ile açılır, panel dışına tıklanınca kapanır (StaysOpen=False) -->
                <Popup x:Name="ContactPopup"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PlacementTarget="{Binding ElementName=ContactSearchBox}"
                       Placement="Bottom"
                       VerticalOffset="2">
                    <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1"
                            CornerRadius="4" Padding="4"
                            Width="{Binding ActualWidth, ElementName=ContactSearchBox}">
                        <ListBox x:Name="ContactListBox"
                                 MaxHeight="150" BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Display}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              FontSize="12"
                                              Checked="ContactCheckBox_Changed"
                                              Unchecked="ContactCheckBox_Changed"
                                              ToolTip="{Binding Phone}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Popup>

                <!-- Seçilen kişiler (chip listesi) — liste kapalıyken de görünür -->
                <ItemsControl x:Name="SelectedChips" Margin="0,6,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#E3F2FD" BorderBrush="#90CAF9" BorderThickness="1"
                                    CornerRadius="10" Padding="8,3" Margin="0,0,6,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Display}" Style="{StaticResource Text.Caption}"
                                               VerticalAlignment="Center"
                                               ToolTip="{Binding Phone}"/>
                                    <Button Content="✕" FontSize="12" Margin="6,0,0,0"
                                            Padding="2,0" BorderThickness="0"
                                            Background="Transparent" Cursor="Hand"
                                            Click="RemoveChip_Click" Tag="{Binding}"
                                            ToolTip="Seçimden çıkar"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Mail alanları paneli — yalnızca mail modunda görünür -->
        <Border x:Name="MailFieldsPanel"
                DockPanel.Dock="Top"
                Background="#F8F9FA" BorderBrush="#CBD5E1" BorderThickness="1"
                CornerRadius="4" Padding="10,8" Margin="0,0,0,8"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="75"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Gönderici (salt okunur) -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Gönderici:" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,6,5"/>
                <TextBlock Grid.Row="0" Grid.Column="1"
                           x:Name="FromBlock"
                           FontStyle="Italic" Foreground="#555"
                           VerticalAlignment="Center" Margin="0,0,0,5"/>

                <!-- Alıcı — birden fazla adres kabul eder (";" ile ayrılır).
                     "Rehber" butonu ortak mail rehberinden çoklu seçim yapar ve
                     seçilenleri mevcut adreslerin üzerine ekler. -->
                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="Alıcı *:" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,6,5"/>
                <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,5">
                    <Button x:Name="ToPickButton"
                            DockPanel.Dock="Right"
                            Content="📇 Rehber" Width="80" Height="24" Margin="4,0,0,0"
                            Padding="0" FontSize="12"
                            Style="{StaticResource SecondaryButton}"
                            Click="ToPickButton_Click"
                            ToolTip="Mail rehberinden alıcı seç"/>
                    <TextBox x:Name="ToTextBox"
                             Padding="4,3"
                             BorderThickness="1" BorderBrush="#CBD5E1"
                             VerticalContentAlignment="Center"
                             TextChanged="RecipientBoxes_TextChanged"
                             ToolTip="Birden fazla adres yazabilirsiniz — noktalı virgül veya virgülle ayırın. Adresler yalnızca bu gönderim için kullanılır, DB'ye kaydedilmez."/>
                </DockPanel>

                <!-- CC — "Varsayılan CC" işaretli rehber kişileri açılışta otomatik dolar -->
                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="CC:" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,6,5"/>
                <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,5">
                    <Button x:Name="CcPickButton"
                            DockPanel.Dock="Right"
                            Content="📇 Rehber" Width="80" Height="24" Margin="4,0,0,0"
                            Padding="0" FontSize="12"
                            Style="{StaticResource SecondaryButton}"
                            Click="CcPickButton_Click"
                            ToolTip="Mail rehberinden CC seç"/>
                    <TextBox x:Name="CcTextBox"
                             Padding="4,3"
                             BorderThickness="1" BorderBrush="#CBD5E1"
                             VerticalContentAlignment="Center"
                             TextChanged="RecipientBoxes_TextChanged"
                             ToolTip="İsteğe bağlı — birden fazla adres için noktalı virgül kullanın. 'Varsayılan CC' işaretli rehber kişileri otomatik eklenir."/>
                </DockPanel>

                <!-- Konu (düzenlenebilir, önceden dolu) -->
                <TextBlock Grid.Row="3" Grid.Column="0"
                           Text="Konu:" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,6,5"/>
                <TextBox   Grid.Row="3" Grid.Column="1"
                           x:Name="SubjectTextBox"
                           Padding="4,3" Margin="0,0,0,5"
                           BorderThickness="1" BorderBrush="#CBD5E1"/>

                <!-- Adres doğrulama uyarısı: hangi adresin hatalı olduğunu anında gösterir -->
                <TextBlock Grid.Row="4" Grid.Column="1"
                           x:Name="RecipientWarningBlock"
                           Foreground="#C2410C" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- Alt butonlar -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="CopyButton"
                    Content="📋 Kopyala" Width="100" Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButton}"
                    Click="CopyButton_Click"
                    ToolTip="Mesaj metnini panoya kopyalar"/>

            <!-- WhatsApp Web butonu: link açılınca durum otomatik güncellenir -->
            <Button x:Name="WhatsAppWebButton"
                    Content="🌐 WhatsApp Web" Width="130" Margin="0,0,8,0"
                    Style="{StaticResource PrimaryButton}"
                    Click="WhatsAppWebButton_Click"
                    ToolTip="WhatsApp Web'i açar; başarılı olunca bildirim durumu otomatik güncellenir"
                    Visibility="Collapsed"/>

            <!-- Mail Gönder butonu: SMTP gönderi başarılıysa durum otomatik güncellenir -->
            <Button x:Name="MailSendButton"
                    Content="📧 Mail Gönder" Width="110" Margin="0,0,8,0"
                    Style="{StaticResource PrimaryButton}"
                    Click="MailSendButton_Click"
                    ToolTip="Mail gönderir; başarılı olunca bildirim durumu otomatik güncellenir"
                    Visibility="Collapsed"/>

            <Button Content="✕ Kapat" Width="85"
                    Style="{StaticResource SecondaryButton}"
                    IsCancel="True" Click="CloseButton_Click"/>
        </StackPanel>

        <!-- Başarı bildirimi — pencere kapanmadan önce kısa süre görünür (1.5 sn) -->
        <Border x:Name="SuccessToast"
                DockPanel.Dock="Bottom"
                Background="#E8F5E9" BorderBrush="#81C784" BorderThickness="0,1,0,0"
                CornerRadius="0,0,0,0" Padding="10,7" Margin="0,6,0,0"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="✓  " Foreground="#2E7D32"
                           Style="{StaticResource Text.Body}" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock x:Name="SuccessToastText" Foreground="#2E7D32"
                           Style="{StaticResource Text.Caption}" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Mesaj metni — her iki modda salt okunur -->
        <TextBox x:Name="MessageBodyBox"
                 IsReadOnly="True" AcceptsReturn="True"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 FontFamily="Segoe UI" FontSize="14"
                 Background="#FAFAFA" BorderBrush="#CBD5E1" BorderThickness="1"
                 Padding="10"/>

    </DockPanel>
</Window>
