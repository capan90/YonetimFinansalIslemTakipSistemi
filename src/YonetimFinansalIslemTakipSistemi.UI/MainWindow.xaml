<Window x:Class="YonetimFinansalIslemTakipSistemi.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:common="clr-namespace:YonetimFinansalIslemTakipSistemi.UI.Common"
        mc:Ignorable="d"
        Title="Yönetim — Nakit İşlemler"
        Height="640" Width="1280"
        MinWidth="900" MinHeight="500"
        Icon="Assets/AppIcon.ico">

    <!-- Klavye kısayolları — mevcut Click handler'ları sarmalayıcı üzerinden çağrılır,
         imzalar ve iş mantığı değişmez (bkz. Common/AppCommands.cs).
         F5 doğrudan ViewModel'in FilterCommand'ına bağlıdır. -->
    <Window.CommandBindings>
        <CommandBinding Command="common:AppCommands.New"           Executed="Command_New"/>
        <CommandBinding Command="common:AppCommands.Duplicate"     Executed="Command_Duplicate"/>
        <CommandBinding Command="common:AppCommands.DeleteSelected" Executed="Command_Delete"/>
        <CommandBinding Command="common:AppCommands.FocusSearch"   Executed="Command_FocusSearch"/>
        <CommandBinding Command="common:AppCommands.ImportExcel"   Executed="Command_ImportExcel"/>
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Key="N"      Modifiers="Ctrl" Command="common:AppCommands.New"/>
        <KeyBinding Key="D"      Modifiers="Ctrl" Command="common:AppCommands.Duplicate"/>
        <KeyBinding Key="Delete"                  Command="common:AppCommands.DeleteSelected"/>
        <KeyBinding Key="F"      Modifiers="Ctrl" Command="common:AppCommands.FocusSearch"/>
        <KeyBinding Key="E"      Modifiers="Ctrl" Command="common:AppCommands.ImportExcel"/>
        <KeyBinding Key="F5"                      Command="{Binding FilterCommand}"/>
    </Window.InputBindings>

    <DockPanel Background="{DynamicResource Theme.SurfaceSubtle}">

        <!-- Menü çubuğu -->
        <Menu DockPanel.Dock="Top" Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="0,0,0,1">
            <MenuItem Header="Yönetim">
                <!-- Sadece iş/yönetim işlevleri; teknik işlemler Ayarlar altına taşındı -->
                <MenuItem x:Name="MenuItemKullanicilar"
                          Header="Kullanıcılar"
                          Click="OpenUserManagement_Click"/>
                <MenuItem x:Name="MenuItemYetkiler"
                          Header="Yetkiler"
                          Click="OpenPermissions_Click"/>
                <MenuItem x:Name="MenuItemDenetim"
                          Header="Denetim Günlüğü"
                          Click="OpenAuditLog_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuItemRaporlar"
                          Header="Raporlar"
                          Click="OpenReports_Click"/>
                <MenuItem x:Name="MenuItemAnaliz"
                          Header="Finans Analiz Merkezi"
                          Click="OpenAnalysis_Click"/>
                <MenuItem x:Name="MenuItemDoviz"
                          Header="Döviz Kurları"
                          Click="OpenExchangeRates_Click"/>
            </MenuItem>

            <!-- Kargo Takip modülü -->
            <MenuItem x:Name="MenuItemKargoKatip" Header="Kargo Takip">
                <MenuItem x:Name="MenuItemKargoDashboard"
                          Header="Dashboard"
                          Click="OpenCargoDashboard_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuItemGelenKargolar"
                          Header="Gelen Kargolar"
                          Click="OpenIncomingCargo_Click"/>
                <MenuItem x:Name="MenuItemGidenKargolar"
                          Header="Giden Kargolar"
                          Click="OpenOutgoingCargo_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuItemFirmaRehberi"
                          Header="Firma Rehberi"
                          Click="OpenCompanyDirectory_Click"/>
                <MenuItem x:Name="MenuItemKargoFirmalari"
                          Header="Kargo Firmaları"
                          Click="OpenCargoCompanies_Click"/>
                <MenuItem x:Name="MenuItemWhatsAppRehberi"
                          Header="WhatsApp Rehberi"
                          ToolTip="Tüm kullanıcıların ortak kullandığı WhatsApp alıcı rehberi."
                          Click="OpenWhatsAppContacts_Click"/>
                <MenuItem x:Name="MenuItemMailRehberi"
                          Header="Mail Rehberi"
                          ToolTip="Kargo bildirim maillerinde kullanılan ortak alıcı/CC rehberi. 'Varsayılan CC' işaretli kişiler her mailde otomatik eklenir."
                          Click="OpenMailContacts_Click"/>
            </MenuItem>

            <!-- Ayarlar: mail + teknik/operasyonel işlemler -->
            <MenuItem x:Name="MenuItemAyarlar" Header="Ayarlar">
                <MenuItem x:Name="MenuItemMailAyarlari"
                          Header="Mail Ayarları"
                          ToolTip="SMTP sunucusu ve e-posta bildirim ayarlarını yönetin."
                          Click="OpenMailSettings_Click"/>
                <MenuItem x:Name="MenuItemSistemLoglari"
                          Header="Sistem Logları"
                          ToolTip="Uygulama sistem loglarını ve hata kayıtlarını görüntüleyin."
                          Click="OpenSystemLogs_Click"/>
                <MenuItem x:Name="MenuItemGorunumAyarlari"
                          Header="Görünüm Ayarları"
                          ToolTip="Uygulama temasını (açık / koyu) değiştirin."
                          Click="OpenAppearanceSettings_Click"/>
                <!-- Harf Duyarlılığı bilinçli olarak burada DEĞİL: kişisel ayardır,
                     Yardım → Kullanıcı Ayarlarım altından yetkisiz erişilir -->
                <Separator/>
                <MenuItem x:Name="MenuItemSistemSagligi"
                          Header="Sistem Sağlığı"
                          ToolTip="Uygulama, veritabanı, log, backup ve güncelleme durumunu özetler."
                          Click="OpenSystemHealth_Click"/>
                <MenuItem x:Name="MenuItemDbTest"
                          Header="Veritabanı Bağlantısını Test Et"
                          ToolTip="Mevcut veritabanı bağlantısını hemen test eder ve sonucu gösterir."
                          Click="TestDbConnection_Click"/>
                <MenuItem x:Name="MenuItemLogKlasor"
                          Header="Log Klasörünü Aç"
                          ToolTip="Uygulama log dosyalarının bulunduğu klasörü Explorer'da açar."
                          Click="OpenLogDirectory_Click"/>
            </MenuItem>

            <MenuItem Header="Yardım">
                <MenuItem Header="Güncellemeleri Denetle"
                          ToolTip="Yayın klasöründeki en güncel sürümü kontrol eder; güncelleme varsa bildirir."
                          Click="CheckForUpdates_Click"/>
                <MenuItem Header="Mail Ayarlarım"
                          ToolTip="Kendi mail gönderim bilgilerinizi düzenleyin."
                          Click="OpenPersonalMailSettings_Click"/>
                <!-- Kişisel kullanıcı ayarları: CanAccessSettings gerektirmez —
                     giriş yapan her kullanıcı kendi tercihini yönetebilir.
                     Ayarlar menüsündeki aynı pencere/handler altyapısını kullanır. -->
                <MenuItem Header="Kullanıcı Ayarlarım">
                    <MenuItem Header="Harf Duyarlılığı"
                              ToolTip="Girdiğiniz metinlerin BÜYÜK/küçük harf dönüşüm tercihini belirleyin (kişisel ayar)."
                              Click="OpenTextCaseSettings_Click"/>
                </MenuItem>
                <MenuItem Header="Log Klasörünü Aç"
                          ToolTip="Uygulama loglarının bulunduğu klasörü açar."
                          Click="OpenLogDirectory_Click"/>
            </MenuItem>
        </Menu>

        <DockPanel Margin="10">

            <!-- Bakiye Kartları — para birimi başına ayrı kart, renk bağlaması converter ile -->
            <UniformGrid DockPanel.Dock="Top" Columns="3" Margin="0,0,0,10">

                <Border Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1"
                        CornerRadius="6" Margin="0,0,6,0" Padding="14,10">
                    <Border.Effect>
                        <DropShadowEffect Color="{DynamicResource Theme.ShadowColor}" Direction="270" ShadowDepth="1"
                                          BlurRadius="6" Opacity="0.3"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="TL BAKİYE"
                                   Foreground="{DynamicResource Theme.LabelText}" Style="{StaticResource Text.Caption}" FontWeight="SemiBold"
                                   Margin="0,0,0,4"/>
                        <!-- Tag işareti taşır; renk stildeki DataTrigger'dan gelir (tema uyumlu) -->
                        <TextBlock Text="{Binding TlBalance, StringFormat=N2}"
                                   Tag="{Binding TlBalance, Converter={StaticResource DecimalSign}}"
                                   Style="{StaticResource Text.BalanceAmount}"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1"
                        CornerRadius="6" Margin="3,0,3,0" Padding="14,10">
                    <Border.Effect>
                        <DropShadowEffect Color="{DynamicResource Theme.ShadowColor}" Direction="270" ShadowDepth="1"
                                          BlurRadius="6" Opacity="0.3"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="USD BAKİYE"
                                   Foreground="{DynamicResource Theme.LabelText}" Style="{StaticResource Text.Caption}" FontWeight="SemiBold"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding UsdBalance, StringFormat=N2}"
                                   Tag="{Binding UsdBalance, Converter={StaticResource DecimalSign}}"
                                   Style="{StaticResource Text.BalanceAmount}"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1"
                        CornerRadius="6" Margin="6,0,0,0" Padding="14,10">
                    <Border.Effect>
                        <DropShadowEffect Color="{DynamicResource Theme.ShadowColor}" Direction="270" ShadowDepth="1"
                                          BlurRadius="6" Opacity="0.3"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="EUR BAKİYE"
                                   Foreground="{DynamicResource Theme.LabelText}" Style="{StaticResource Text.Caption}" FontWeight="SemiBold"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding EurBalance, StringFormat=N2}"
                                   Tag="{Binding EurBalance, Converter={StaticResource DecimalSign}}"
                                   Style="{StaticResource Text.BalanceAmount}"/>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- Araç çubuğu -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <!-- Sağ: kullanıcı + çıkış -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="LoggedInUserText"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               Foreground="{DynamicResource Theme.LabelText}"
                               Style="{StaticResource Text.Body}"/>
                    <Button Content="Çıkış Yap"
                            Width="90"
                            Style="{StaticResource SecondaryButton}"
                            Click="Logout_Click"/>
                </StackPanel>
                <!-- Sol: işlem butonları -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="+ Yeni İşlem"
                            Width="110" Margin="0,0,6,0"
                            Style="{StaticResource PrimaryButton}"
                            ToolTip="Yeni bir nakit işlem kaydı oluşturur."
                            Click="NewTransactionButton_Click"/>
                    <Button x:Name="CashImportButton"
                            Width="170" Margin="0,0,6,0"
                            Style="{StaticResource SecondaryButton}"
                            ToolTip="Excel dosyasından toplu finans işlemi oluşturur: analiz → önizleme → onay → içe aktarma"
                            Click="CashImportButton_Click">
                        <StackPanel Style="{StaticResource IconTextPanel}">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Download}" Margin="0,0,6,0"/>
                            <TextBlock Text="Excel'den İçe Aktar"/>
                        </StackPanel>
                    </Button>
                    <Button Content="Düzenle"
                            Width="80" Margin="0,0,6,0"
                            Style="{StaticResource SecondaryButton}"
                            ToolTip="Seçili işlemi düzenler."
                            IsEnabled="{Binding HasSelectedTransaction}"
                            Click="EditTransactionButton_Click"/>
                    <Button x:Name="CopyTransactionButton"
                            Content="Kopyala"
                            Width="80" Margin="0,0,6,0"
                            Style="{StaticResource SecondaryButton}"
                            ToolTip="Seçili işlemin bilgileriyle yeni işlem formu açar."
                            IsEnabled="{Binding HasSelectedTransaction}"
                            Click="CopyTransactionButton_Click"/>
                    <Button Content="Sil"
                            Width="60"
                            Style="{StaticResource DangerButton}"
                            ToolTip="Seçili işlemi siler. Kayıt denetim günlüğünde saklanır."
                            IsEnabled="{Binding HasSelectedTransaction}"
                            Click="DeleteTransactionButton_Click"/>
                </StackPanel>
            </DockPanel>

            <!-- Filtre Paneli -->
            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1"
                    CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                <WrapPanel Orientation="Horizontal" ItemHeight="30">

                    <Label Content="Başlangıç:" VerticalAlignment="Center" Foreground="{DynamicResource Theme.LabelText}"/>
                    <DatePicker SelectedDate="{Binding DateFrom, Mode=TwoWay}"
                                Width="130" Margin="0,0,10,0"/>

                    <Label Content="Bitiş:" VerticalAlignment="Center" Foreground="{DynamicResource Theme.LabelText}"/>
                    <DatePicker SelectedDate="{Binding DateTo, Mode=TwoWay}"
                                Width="130" Margin="0,0,10,0"/>

                    <Label Content="İşlem Türü:" VerticalAlignment="Center" Foreground="{DynamicResource Theme.LabelText}"/>
                    <ComboBox ItemsSource="{Binding TransactionTypeOptions}"
                              SelectedItem="{Binding SelectedTransactionType, Mode=TwoWay}"
                              Width="90" Margin="0,0,10,0"/>

                    <Label Content="Para Birimi:" VerticalAlignment="Center" Foreground="{DynamicResource Theme.LabelText}"/>
                    <ComboBox ItemsSource="{Binding CurrencyTypeOptions}"
                              SelectedItem="{Binding SelectedCurrencyType, Mode=TwoWay}"
                              Width="90" Margin="0,0,10,0"/>

                    <Label Content="Açıklama:" VerticalAlignment="Center" Foreground="{DynamicResource Theme.LabelText}"/>
                    <!-- Ctrl+F bu alana odaklanır -->
                    <TextBox x:Name="DescriptionFilterBox"
                             Text="{Binding DescriptionFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Width="160" Margin="0,0,10,0"
                             ToolTip="Açıklamada ara (Ctrl+F)"/>

                    <Label Content="Tutar:" VerticalAlignment="Center" Foreground="{DynamicResource Theme.LabelText}"/>
                    <ComboBox ItemsSource="{Binding AmountOperatorOptions}"
                              SelectedItem="{Binding SelectedAmountOperator, Mode=TwoWay}"
                              Width="48" Margin="0,0,4,0"/>
                    <TextBox Text="{Binding AmountValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Width="90" Margin="0,0,10,0"/>

                    <Button Content="Filtrele"
                            Command="{Binding FilterCommand}"
                            Width="80"
                            Style="{StaticResource PrimaryButton}"/>

                </WrapPanel>
            </Border>

            <!-- Liste özet şeridi — DataGrid'den ÖNCE tanımlanır çünkü DockPanel'de
                 son çocuk kalan alanı doldurur; tablo son çocuk olmalı.
                 Üstteki bakiye kartlarından farkı: kartlar filtreden bağımsız genel
                 bakiyeyi, bu şerit ekranda görünen filtrelenmiş satırları özetler. -->
            <Border DockPanel.Dock="Bottom"
                    Background="{DynamicResource Theme.DataGridHeader}"
                    BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1,0,1,1"
                    Padding="10,6" Margin="0,0,0,0">
                <TextBlock Text="{Binding ListSummary}"
                           Style="{StaticResource Text.Caption}"
                           ToolTip="Filtre uygulandıktan sonra listede görünen satırların özeti. Para birimleri karışık olabilir."/>
            </Border>

            <!-- İşlem Listesi -->
            <DataGrid x:Name="TransactionDataGrid"
                      ItemsSource="{Binding Transactions}"
                      SelectedItem="{Binding SelectedTransaction, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource Theme.Border}"
                      AlternatingRowBackground="{DynamicResource Theme.DataGridAltRow}"
                      RowBackground="{DynamicResource Theme.DataGridRow}"
                      HeadersVisibility="Column"
                      BorderBrush="{DynamicResource Theme.Border}"
                      BorderThickness="1"
                      MouseDoubleClick="TransactionDataGrid_MouseDoubleClick">

                <!-- Sağ tıklama context menu'su kod arkasında atanır (bkz. MainWindow.xaml.cs) -->

                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="ColTarih"
                                        Header="Tarih"
                                        Binding="{Binding TransactionDate, StringFormat=dd.MM.yyyy}"
                                        Width="90"
                                    ElementStyle="{StaticResource EllipsisCell}"/>
                    <DataGridTextColumn x:Name="ColTur"
                                        Header="Tür"
                                        Binding="{Binding TransactionTypeDisplay}"
                                        Width="80"
                                    ElementStyle="{StaticResource EllipsisCell}"/>
                    <DataGridTextColumn x:Name="ColParaBir"
                                        Header="Para Bir."
                                        Binding="{Binding CurrencyTypeDisplay}"
                                        Width="75"
                                    ElementStyle="{StaticResource EllipsisCell}"/>
                    <DataGridTextColumn x:Name="ColAciklama"
                                        Header="Açıklama"
                                        Binding="{Binding Description}"
                                        Width="*"
                                    ElementStyle="{StaticResource EllipsisCell}"/>
                    <DataGridTextColumn x:Name="ColBorc"
                                        Header="Borç"
                                        Binding="{Binding Borc, StringFormat=N2}"
                                        Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCell}">
                                
                                <Setter Property="Foreground" Value="{DynamicResource Theme.Success}"/>
                                <Setter Property="Padding" Value="0,0,4,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn x:Name="ColAlacak"
                                        Header="Alacak"
                                        Binding="{Binding Alacak, StringFormat=N2}"
                                        Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCell}">
                                
                                <Setter Property="Foreground" Value="{DynamicResource Theme.Danger}"/>
                                <Setter Property="Padding" Value="0,0,4,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn x:Name="ColTlBakiye"
                                        Header="TL Bakiye"
                                        Binding="{Binding TlBalanceAfter, StringFormat=N2}"
                                        Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCell}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn x:Name="ColUsdBakiye"
                                        Header="USD Bakiye"
                                        Binding="{Binding UsdBalanceAfter, StringFormat=N2}"
                                        Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCell}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn x:Name="ColEurBakiye"
                                        Header="EUR Bakiye"
                                        Binding="{Binding EurBalanceAfter, StringFormat=N2}"
                                        Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCell}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn x:Name="ColOlusturulmaT"
                                        Header="Oluşturulma"
                                        Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm}"
                                        Width="130"
                                    ElementStyle="{StaticResource EllipsisCell}"/>
                </DataGrid.Columns>
            </DataGrid>

        </DockPanel>

    </DockPanel>
</Window>
