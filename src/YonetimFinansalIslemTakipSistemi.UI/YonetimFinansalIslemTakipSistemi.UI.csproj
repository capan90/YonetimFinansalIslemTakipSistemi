<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\YonetimFinansalIslemTakipSistemi.Application\YonetimFinansalIslemTakipSistemi.Application.csproj" />
    <ProjectReference Include="..\YonetimFinansalIslemTakipSistemi.Infrastructure\YonetimFinansalIslemTakipSistemi.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Başlangıç ekranı kararı (App.ResolveStartupMode) ve kabuk penceresinin
      test kurucusu doğrudan sınanabilsin diye. Kaynak metni tarayarak
      doğrulamak bu kararı kanıtlamaz — yetki kümesi gerçekten çalıştırılmalı.
    -->
    <InternalsVisibleTo Include="YonetimFinansalIslemTakipSistemi.UiTests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Grafik motoru (Faz C). SkiaSharp ile çizer; WPF fırçalarını KULLANMAZ,
      dolayısıyla DynamicResource'u görmez — renkler Common/ChartPalette.cs
      üzerinden token'lardan okunur ve tema değiştiğinde yeniden uygulanır.

      NU1701 bastırması için bkz. aşağıdaki PropertyGroup.
    -->
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="9.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.1" />
    <PackageReference Include="Serilog" Version="4.*" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.*" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.*" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.*" />
  </ItemGroup>

  <!-- appsettings.json: ortak taban ayar. Build çıktısına ve ClickOnce paketine her zaman dahil edilir. -->
  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>

    <!-- Development: yerel geliştirme/EF migration için build çıktısına kopyalanır.
         Üretim paketine dahil edilmez (Publish=Never) — istemci Production ortamıyla çalışır. -->
    <Content Include="appsettings.Development.json" Condition="Exists('appsettings.Development.json')">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>

    <!-- Production: gitignore'da; yalnızca publish makinesinde bulunur (gerçek bağlantı dizesi).
         Yerelde yoksa build kırılmaz (Condition=Exists). Varsa ClickOnce paketine dahil edilir. -->
    <Content Include="appsettings.Production.json" Condition="Exists('appsettings.Production.json')">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\AppIcon.ico" />
    <Resource Include="Assets\LoginIcon.png" />
    <!-- CompanyLogo.png opsiyonel: dosya eklenince otomatik resource olarak dahil edilir -->
    <Resource Include="Assets\CompanyLogo.png" Condition="Exists('Assets\CompanyLogo.png')" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!--
      NU1701 — LiveCharts'ın transitif bağımlılıkları (SkiaSharp.Views.WPF,
      OpenTK, OpenTK.GLWpfControl) yalnızca .NET Framework hedefliyor ve restore
      sırasında altı uyarı üretiyorlar. Doğrudan referansımız olmadığı için
      PackageReference üzerinde NoWarn işe yaramıyor; bastırma proje düzeyinde.

      BASTIRMADAN ÖNCE ÇALIŞTIĞI DOĞRULANDI (UiTests/ChartRuntimeTests.cs):
      .NET 9 WPF üzerinde CartesianChart oluşturulup ölçüldü ve native
      libSkiaSharp yüklendi. Uyarı gerçek bir uyumsuzluğu değil, paketlerin eski
      hedef çerçevesini bildiriyor.

      Kapsam bilinçli olarak dar: yalnızca UI ve UiTests projelerinde bastırılır.
      Domain / Application / Infrastructure tam uyarı seviyesinde kalır, oraya
      uyumsuz bir paket girerse uyarı görünür.
    -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <!-- Her release öncesi artırılır; pubxml PublishVersion ve version.json ile senkron tutulmalıdır -->
    <AssemblyVersion>1.0.1.2</AssemblyVersion>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    dotnet publish, SetGenerateManifests (VS-only) target'ını atlar.
    Bu target _DeploymentGenerateLauncher koşulunu önceden true yapar.
  -->
  <Target Name="_ForceClickOnceManifests" BeforeTargets="_DeploymentGenerateLauncher" Condition="'$(PublishProtocol)' == 'ClickOnce'">
    <PropertyGroup>
      <GenerateClickOnceManifests>true</GenerateClickOnceManifests>
    </PropertyGroup>
  </Target>

  <!-- ClickOnce publish tamamlandıktan sonra version.json'ı UNC klasörüne yazar -->
  <Target Name="WriteVersionJson" AfterTargets="Publish" Condition="'$(PublishProtocol)' == 'ClickOnce' and '$(PublishUrl)' != ''">
    <PropertyGroup>
      <_VersionJsonContent>{"version":"$(AssemblyVersion)"}</_VersionJsonContent>
    </PropertyGroup>
    <Message Text="version.json yazılıyor: $(PublishUrl)version.json" Importance="high" />
    <WriteLinesToFile File="$(PublishUrl)version.json" Lines="$(_VersionJsonContent)" Overwrite="true" />
  </Target>

</Project>
