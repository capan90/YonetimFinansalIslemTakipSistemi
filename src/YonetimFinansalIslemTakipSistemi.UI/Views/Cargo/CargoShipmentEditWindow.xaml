<Window x:Class="YonetimFinansalIslemTakipSistemi.UI.Views.Cargo.CargoShipmentEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        SizeToContent="Height" Width="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="pack://application:,,,/Assets/AppIcon.ico">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <!-- Ctrl+S = Kaydet -->
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}"/>
    </Window.InputBindings>

    <StackPanel Margin="16">

        <!-- Tarih + Kargo No -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <Label Content="Tarih *:" Margin="0,0,0,2"/>
                <DatePicker SelectedDate="{Binding ShipmentDate, Mode=TwoWay}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <Label Content="Kargo No:" Margin="0,0,0,2"
                       ToolTip="Sistem tarafından otomatik üretilir (Gelen: GLN00001, Giden: GDN00001)"/>
                <!-- Salt okunur: numara atomik sayaçtan üretilir, kullanıcı değiştiremez.
                     Yeni kayıtta placeholder metin görünür; numara form açılırken rezerve edilmez -->
                <TextBox Text="{Binding ShipmentNumberDisplay, Mode=OneWay}"
                         IsReadOnly="True" Background="{DynamicResource Theme.SurfaceAlt}" Foreground="{DynamicResource Theme.LabelText}"
                         ToolTip="Kayıt sırasında otomatik atanır; değiştirilemez"/>
            </StackPanel>
        </Grid>

        <!-- Kargo Türü + Öncelik -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <Label Content="Kargo Türü:" Margin="0,0,0,2"/>
                <!-- Opsiyonel alan: "— Seçim yok —" ile boş bırakılabilir -->
                <ComboBox ItemsSource="{Binding ShipmentTypeOptions}"
                          SelectedItem="{Binding SelectedShipmentType, Mode=TwoWay}"
                          ToolTip="Gönderi içeriğinin türü. Boş bırakmak için '— Seçim yok —' satırını seçin."/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <Label Content="Öncelik:" Margin="0,0,0,2"/>
                <ComboBox ItemsSource="{Binding PriorityOptions}"
                          SelectedItem="{Binding SelectedPriority, Mode=TwoWay}"
                          ToolTip="Normal=gri | Orta=mavi | Acil=turuncu | Çok Acil=kırmızı. Liste ekranında renk badge olarak görünür."/>
            </StackPanel>
        </Grid>

        <!-- Durum + Bildirim Durumu -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <Label Content="Durum:" Margin="0,0,0,2"
                       ToolTip="Düzenleme modunda yalnızca geçerli geçişler gösterilir"/>
                <!-- AllowedStatusOptions: düzenleme modunda sadece geçerli geçişler listelenir -->
                <ComboBox ItemsSource="{Binding AllowedStatusOptions}"
                          SelectedItem="{Binding SelectedStatus, Mode=TwoWay}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <Label Content="Bildirim Durumu:" Margin="0,0,0,2"
                       ToolTip="WhatsApp veya mail mesajının hazırlanıp hazırlanmadığını gösterir. Operasyon Merkezi üzerinden otomatik güncellenir."/>
                <ComboBox ItemsSource="{Binding NotificationStatusOptions}"
                          SelectedItem="{Binding SelectedNotificationStatus, Mode=TwoWay}"
                          ToolTip="Gerçek WhatsApp/mail gönderimi yapılmaz; yalnızca durum kaydedilir."/>
            </StackPanel>
        </Grid>

        <!-- Kargo Firması + hızlı ekleme -->
        <Label Content="Kargo Firması:" Margin="0,0,0,2"/>
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0"
                      ItemsSource="{Binding CargoCompanies}"
                      SelectedItem="{Binding SelectedCargoCompany, Mode=TwoWay}"
                      DisplayMemberPath="Name"
                      ToolTip="Seçilen firmanın portal/takip bağlantısı kullanılır. Seçimi kaldırmak için '— Seçim yok —' satırını seçin."/>
            <Button x:Name="AddCargoCompanyButton" Grid.Column="2"
                    Content="+" Width="26" Height="22"
                    VerticalAlignment="Center"
                    ToolTip="Yeni kargo firması ekle"
                    Click="AddCargoCompanyButton_Click"/>
        </Grid>

        <!-- Kargo portal bağlantısı — seçili firmanın kaydından gelir, salt okunur -->
        <Grid Margin="0,0,0,8"
              Visibility="{Binding HasPortalUrl, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Text="{Binding SelectedCompanyPortalUrl, Mode=OneWay}"
                     IsReadOnly="True" Background="{DynamicResource Theme.SurfaceAlt}" Foreground="{DynamicResource Theme.LabelText}"
                     ToolTip="Kargo firmasının portal/takip bağlantısı — yalnızca Kargo Firmaları ekranından düzenlenir"/>
            <Button Grid.Column="2"
                    Content="Portalı / Takibi Aç" Width="115" Height="22"
                    VerticalAlignment="Center"
                    ToolTip="Firmanın portal/takip bağlantısını varsayılan tarayıcıda açar"
                    Click="OpenPortalButton_Click"/>
        </Grid>

        <!-- Firma Rehberi + hızlı ekleme -->
        <Label Content="Firma Rehberi (Karşı Taraf):" Margin="0,0,0,2"/>
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0"
                      ItemsSource="{Binding CompanyDirectories}"
                      SelectedItem="{Binding SelectedCompanyDirectory, Mode=TwoWay}"
                      DisplayMemberPath="DisplayLabel"
                      ToolTip="Giden kargoda seçilen firmanın adres/iletişim bilgileri otomatik doldurulur. Aynı firmanın farklı adres/telefon kayıtları ilçe/il ve telefonla ayırt edilir. Seçimi kaldırmak için '— Seçim yok —' satırını seçin."/>
            <Button x:Name="AddDirectoryButton" Grid.Column="2"
                    Content="+" Width="26" Height="22"
                    VerticalAlignment="Center"
                    ToolTip="Yeni firma rehberi kaydı ekle"
                    Click="AddDirectoryButton_Click"/>
        </Grid>

        <!-- Dikkatine Kişisi — firma seçildiğinde geçmiş kişiler listelenir -->
        <Label Content="Dikkatine:" Margin="0,0,0,2"
               ToolTip="Kargo etiketine ve bildirimlere basılacak dikkatine kişisi"/>
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0"
                      IsEditable="True"
                      ItemsSource="{Binding AttentionContacts}"
                      Text="{Binding AttentionContactInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      ToolTip="Listeden seçin veya yeni isim yazın. '+' ile firmaya ekleyebilirsiniz."/>
            <Button x:Name="AddAttentionContactButton" Grid.Column="2"
                    Content="+" Width="26" Height="22"
                    VerticalAlignment="Center"
                    ToolTip="Yazdığınız ismi bu firmanın dikkatine listesine ekle"
                    Click="AddAttentionContactButton_Click"/>
        </Grid>

        <!-- Firma Özeti Kartı — firma seçildiğinde gösterilir -->
        <Border Margin="0,0,0,8" Padding="10,8" Background="{DynamicResource Theme.Info.Background}"
                BorderBrush="{DynamicResource Theme.Info.Border}" BorderThickness="1" CornerRadius="4">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasDirectoryDetails}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18"/>  <!-- ikon -->
                    <ColumnDefinition Width="65"/>  <!-- etiket -->
                    <ColumnDefinition Width="*"/>   <!-- değer -->
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Firma adı -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="🏢" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,4,3"/>
                <TextBlock Grid.Row="0" Grid.Column="1"
                           Text="Firma:" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" Margin="0,0,4,3"/>
                <TextBlock Grid.Row="0" Grid.Column="2"
                           Text="{Binding DirectoryFirma}"
                           Style="{StaticResource Text.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Primary}" Margin="0,0,0,3"/>

                <!-- Dikkatine — "İlgili: Abuzer Bey Dikkatine" veya gizli -->
                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                           Text="{Binding DirectoryContactDisplay}"
                           Margin="0,0,0,3">
                    <TextBlock.Style>
                        <!-- Ölçek stili BasedOn ile: tetikleyicili inline Style ile
                             Style="..." özniteliği aynı anda kullanılamaz -->
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasDirectoryContact}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Adres -->
                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="📍" VerticalAlignment="Top" Margin="0,0,4,3">
                    <TextBlock.Style>
                        <!-- Ölçek stili BasedOn ile: tetikleyicili inline Style ile
                             Style="..." özniteliği aynı anda kullanılamaz -->
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasDirectoryAddress}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Row="2" Grid.Column="1"
                           Text="Adres:" Margin="0,0,4,3">
                    <TextBlock.Style>
                        <!-- Ölçek stili BasedOn ile: tetikleyicili inline Style ile
                             Style="..." özniteliği aynı anda kullanılamaz -->
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasDirectoryAddress}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Row="2" Grid.Column="2"
                           Text="{Binding DirectoryAddress}"
                           TextWrapping="Wrap" Margin="0,0,0,3">
                    <TextBlock.Style>
                        <!-- Ölçek stili BasedOn ile: tetikleyicili inline Style ile
                             Style="..." özniteliği aynı anda kullanılamaz -->
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasDirectoryAddress}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Telefon -->
                <TextBlock Grid.Row="3" Grid.Column="0"
                           Text="📞" VerticalAlignment="Center" Margin="0,0,4,3">
                    <TextBlock.Style>
                        <!-- Ölçek stili BasedOn ile: tetikleyicili inline Style ile
                             Style="..." özniteliği aynı anda kullanılamaz -->
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasDirectoryPhone}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Row="3" Grid.Column="1"
                           Text="Telefon:" Margin="0,0,4,3">
                    <TextBlock.Style>
                        <!-- Ölçek stili BasedOn ile: tetikleyicili inline Style ile
                             Style="..." özniteliği aynı anda kullanılamaz -->
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasDirectoryPhone}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Row="3" Grid.Column="2"
                           Text="{Binding DirectoryPhone}" Margin="0,0,0,3">
                    <TextBlock.Style>
                        <!-- Ölçek stili BasedOn ile: tetikleyicili inline Style ile
                             Style="..." özniteliği aynı anda kullanılamaz -->
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasDirectoryPhone}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- E-posta -->
                <TextBlock Grid.Row="4" Grid.Column="0"
                           Text="✉" VerticalAlignment="Center" Margin="0,0,4,0">
                    <TextBlock.Style>
                        <!-- Ölçek stili BasedOn ile: tetikleyicili inline Style ile
                             Style="..." özniteliği aynı anda kullanılamaz -->
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasDirectoryEmail}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Row="4" Grid.Column="1"
                           Text="E-posta:" Margin="0,0,4,0">
                    <TextBlock.Style>
                        <!-- Ölçek stili BasedOn ile: tetikleyicili inline Style ile
                             Style="..." özniteliği aynı anda kullanılamaz -->
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasDirectoryEmail}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Row="4" Grid.Column="2"
                           Text="{Binding DirectoryEmail}" Foreground="{DynamicResource Theme.Info.Text}">
                    <TextBlock.Style>
                        <!-- Ölçek stili BasedOn ile: tetikleyicili inline Style ile
                             Style="..." özniteliği aynı anda kullanılamaz -->
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasDirectoryEmail}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- Firma snapshot yenileme — yalnızca düzenleme modunda ve firma seçiliyse görünür -->
        <Button x:Name="RefreshSnapshotButton"
                HorizontalAlignment="Left"
                Margin="0,0,0,8" Padding="6,3"
                FontSize="12"
                Click="RefreshSnapshotButton_Click"
                ToolTip="Seçili firma rehberinden alıcı telefon, e-posta ve adres snapshot bilgilerini günceller. Kaydetmeden DB'ye yazılmaz.">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasRefreshableSnapshot}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <StackPanel Style="{StaticResource IconTextPanel}">
                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Refresh}" Margin="0,0,6,0"/>
                <TextBlock Text="Firma Bilgilerini Yenile"/>
            </StackPanel>
        </Button>

        <!-- Gönderi Bilgileri + Teslim Bilgileri — GroupBox olarak ayrılmış -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 4 isim alanı da düzenlenebilir ComboBox: öneriler geçmiş kargo
                 kayıtlarından gelir (yön bazlı), listede olmayan yeni isim serbestçe yazılabilir.
                 "Dikkatine" alanındaki desenle aynıdır. -->
            <GroupBox Grid.Column="0" Header="Gönderi Bilgileri"
                      FontWeight="SemiBold" Padding="6,6,6,6">
                <StackPanel>
                    <Label Content="Gönderen:" FontWeight="Normal" Margin="0,0,0,2"/>
                    <ComboBox IsEditable="True"
                              ItemsSource="{Binding SenderNameSuggestions}"
                              Text="{Binding SenderName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              FontWeight="Normal" Margin="0,0,0,6"
                              ToolTip="Daha önce kullandığınız isimler listelenir — seçebilir veya yeni isim yazabilirsiniz."/>
                    <Label Content="Teslim Eden:" FontWeight="Normal" Margin="0,0,0,2"/>
                    <ComboBox IsEditable="True"
                              ItemsSource="{Binding DeliveredBySuggestions}"
                              Text="{Binding DeliveredBy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              FontWeight="Normal"
                              ToolTip="Daha önce kullandığınız isimler listelenir — seçebilir veya yeni isim yazabilirsiniz."/>
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="Teslim Bilgileri"
                      FontWeight="SemiBold" Padding="6,6,6,6">
                <StackPanel>
                    <Label Content="Alıcı:" FontWeight="Normal" Margin="0,0,0,2"/>
                    <ComboBox IsEditable="True"
                              ItemsSource="{Binding ReceiverNameSuggestions}"
                              Text="{Binding ReceiverName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              FontWeight="Normal" Margin="0,0,0,6"
                              ToolTip="Daha önce kullandığınız isimler listelenir — seçebilir veya yeni isim yazabilirsiniz."/>
                    <Label Content="Teslim Alan:" FontWeight="Normal" Margin="0,0,0,2"/>
                    <ComboBox IsEditable="True"
                              ItemsSource="{Binding ReceivedBySuggestions}"
                              Text="{Binding ReceivedBy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              FontWeight="Normal"
                              ToolTip="Daha önce kullandığınız isimler listelenir — seçebilir veya yeni isim yazabilirsiniz."/>
                </StackPanel>
            </GroupBox>
        </Grid>

        <!-- Takip No + Araç Plakası -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <Label Content="Takip No:" Margin="0,0,0,2"
                       ToolTip="Kargo firmasının verdiği takip numarası. Firma şablonu + bu numara ile Takip Linki otomatik oluşturulur."/>
                <TextBox Text="{Binding TrackingNumber, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <Label Content="Araç Plakası:" Margin="0,0,0,2"
                       ToolTip="Teslimatı gerçekleştiren araç plakası. Kargo etiketinde de gösterilir."/>
                <TextBox Text="{Binding VehiclePlate, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </Grid>

        <!-- Takip Linki alanı kaldırıldı: portal/takip bağlantısının tek kaynağı
             seçili firmanın PortalUrl'i; üstteki "Portalı / Takibi Aç" satırı kullanılır -->
        <Label Content="Notlar:" Margin="0,0,0,2"/>
        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                 Height="48" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                 Margin="0,0,0,12"/>

        <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,8">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Kaydet" Command="{Binding SaveCommand}" IsDefault="True"
                    Width="80" Margin="0,0,8,0"
                    Style="{StaticResource PrimaryButton}"
                    ToolTip="Kaydet (Ctrl+S veya Enter)"/>
            <Button Content="İptal" IsCancel="True" Width="80"
                    Style="{StaticResource SecondaryButton}"
                    Click="CancelButton_Click"
                    ToolTip="İptal (Esc)"/>
        </StackPanel>

    </StackPanel>
</Window>
