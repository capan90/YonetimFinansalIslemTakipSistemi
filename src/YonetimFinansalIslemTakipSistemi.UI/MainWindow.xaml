<Window x:Class="YonetimFinansalIslemTakipSistemi.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:common="clr-namespace:YonetimFinansalIslemTakipSistemi.UI.Common"
        mc:Ignorable="d"
        Title="Yönetim — Nakit İşlemler"
        Height="640" Width="1280"
        MinWidth="900" MinHeight="500"
        Icon="Assets/AppIcon.ico">

    <!-- Klavye kısayolları PENCERE seviyesinde tanımlı kalır: odak menüdeyken de
         çalışmaları gerekiyor. Gövdeleri ekrandaki genel metotlara yönlendirilir
         (bkz. MainWindow.xaml.cs) — mantık iki yerde tutulmaz.

         F5 artık da bu yoldan geçer. Önceden doğrudan {Binding FilterCommand}
         idi; içerik UserControl'e taşınınca pencerenin DataContext'i ekranınkiyle
         aynı ViewModel örneği olmak zorunda kalırdı. ViewModel Transient kayıtlı
         olduğu için bu iki AYRI örnek demekti ve F5 ekranın göstermediği listeyi
         filtrelerdi. -->
    <Window.CommandBindings>
        <CommandBinding Command="common:AppCommands.New"            Executed="Command_New"/>
        <CommandBinding Command="common:AppCommands.Duplicate"      Executed="Command_Duplicate"/>
        <CommandBinding Command="common:AppCommands.DeleteSelected" Executed="Command_Delete"/>
        <CommandBinding Command="common:AppCommands.FocusSearch"    Executed="Command_FocusSearch"/>
        <CommandBinding Command="common:AppCommands.ImportExcel"    Executed="Command_ImportExcel"/>
        <CommandBinding Command="common:AppCommands.RefreshList"    Executed="Command_Refresh"/>
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Key="N"      Modifiers="Ctrl" Command="common:AppCommands.New"/>
        <KeyBinding Key="D"      Modifiers="Ctrl" Command="common:AppCommands.Duplicate"/>
        <KeyBinding Key="Delete"                  Command="common:AppCommands.DeleteSelected"/>
        <KeyBinding Key="F"      Modifiers="Ctrl" Command="common:AppCommands.FocusSearch"/>
        <KeyBinding Key="E"      Modifiers="Ctrl" Command="common:AppCommands.ImportExcel"/>
        <KeyBinding Key="F5"                      Command="common:AppCommands.RefreshList"/>
    </Window.InputBindings>

    <DockPanel Background="{DynamicResource Theme.SurfaceSubtle}">

        <!-- Menü çubuğu -->
        <Menu DockPanel.Dock="Top" Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="0,0,0,1">
            <MenuItem Header="Yönetim">
                <!-- Sadece iş/yönetim işlevleri; teknik işlemler Ayarlar altına taşındı -->
                <MenuItem x:Name="MenuItemKullanicilar"
                          Header="Kullanıcılar"
                          Click="OpenUserManagement_Click"/>
                <MenuItem x:Name="MenuItemYetkiler"
                          Header="Yetkiler"
                          Click="OpenPermissions_Click"/>
                <MenuItem x:Name="MenuItemDenetim"
                          Header="Denetim Günlüğü"
                          Click="OpenAuditLog_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuItemRaporlar"
                          Header="Raporlar"
                          Click="OpenReports_Click"/>
                <MenuItem x:Name="MenuItemAnaliz"
                          Header="Finans Analiz Merkezi"
                          Click="OpenAnalysis_Click"/>
                <MenuItem x:Name="MenuItemDoviz"
                          Header="Döviz Kurları"
                          Click="OpenExchangeRates_Click"/>
            </MenuItem>

            <!-- Kargo Takip modülü -->
            <MenuItem x:Name="MenuItemKargoKatip" Header="Kargo Takip">
                <MenuItem x:Name="MenuItemKargoDashboard"
                          Header="Dashboard"
                          Click="OpenCargoDashboard_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuItemGelenKargolar"
                          Header="Gelen Kargolar"
                          Click="OpenIncomingCargo_Click"/>
                <MenuItem x:Name="MenuItemGidenKargolar"
                          Header="Giden Kargolar"
                          Click="OpenOutgoingCargo_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuItemFirmaRehberi"
                          Header="Firma Rehberi"
                          Click="OpenCompanyDirectory_Click"/>
                <MenuItem x:Name="MenuItemKargoFirmalari"
                          Header="Kargo Firmaları"
                          Click="OpenCargoCompanies_Click"/>
                <MenuItem x:Name="MenuItemWhatsAppRehberi"
                          Header="WhatsApp Rehberi"
                          ToolTip="Tüm kullanıcıların ortak kullandığı WhatsApp alıcı rehberi."
                          Click="OpenWhatsAppContacts_Click"/>
                <MenuItem x:Name="MenuItemMailRehberi"
                          Header="Mail Rehberi"
                          ToolTip="Kargo bildirim maillerinde kullanılan ortak alıcı/CC rehberi. 'Varsayılan CC' işaretli kişiler her mailde otomatik eklenir."
                          Click="OpenMailContacts_Click"/>
            </MenuItem>

            <!-- Ayarlar: mail + teknik/operasyonel işlemler -->
            <MenuItem x:Name="MenuItemAyarlar" Header="Ayarlar">
                <MenuItem x:Name="MenuItemMailAyarlari"
                          Header="Mail Ayarları"
                          ToolTip="SMTP sunucusu ve e-posta bildirim ayarlarını yönetin."
                          Click="OpenMailSettings_Click"/>
                <MenuItem x:Name="MenuItemSistemLoglari"
                          Header="Sistem Logları"
                          ToolTip="Uygulama sistem loglarını ve hata kayıtlarını görüntüleyin."
                          Click="OpenSystemLogs_Click"/>
                <MenuItem x:Name="MenuItemGorunumAyarlari"
                          Header="Görünüm Ayarları"
                          ToolTip="Uygulama temasını (açık / koyu) değiştirin."
                          Click="OpenAppearanceSettings_Click"/>
                <!-- Harf Duyarlılığı bilinçli olarak burada DEĞİL: kişisel ayardır,
                     Yardım → Kullanıcı Ayarlarım altından yetkisiz erişilir -->
                <Separator/>
                <MenuItem x:Name="MenuItemSistemSagligi"
                          Header="Sistem Sağlığı"
                          ToolTip="Uygulama, veritabanı, log, backup ve güncelleme durumunu özetler."
                          Click="OpenSystemHealth_Click"/>
                <MenuItem x:Name="MenuItemDbTest"
                          Header="Veritabanı Bağlantısını Test Et"
                          ToolTip="Mevcut veritabanı bağlantısını hemen test eder ve sonucu gösterir."
                          Click="TestDbConnection_Click"/>
                <MenuItem x:Name="MenuItemLogKlasor"
                          Header="Log Klasörünü Aç"
                          ToolTip="Uygulama log dosyalarının bulunduğu klasörü Explorer'da açar."
                          Click="OpenLogDirectory_Click"/>
            </MenuItem>

            <MenuItem Header="Yardım">
                <MenuItem Header="Güncellemeleri Denetle"
                          ToolTip="Yayın klasöründeki en güncel sürümü kontrol eder; güncelleme varsa bildirir."
                          Click="CheckForUpdates_Click"/>
                <MenuItem Header="Mail Ayarlarım"
                          ToolTip="Kendi mail gönderim bilgilerinizi düzenleyin."
                          Click="OpenPersonalMailSettings_Click"/>
                <!-- Kişisel kullanıcı ayarları: CanAccessSettings gerektirmez —
                     giriş yapan her kullanıcı kendi tercihini yönetebilir.
                     Ayarlar menüsündeki aynı pencere/handler altyapısını kullanır. -->
                <MenuItem Header="Kullanıcı Ayarlarım">
                    <MenuItem Header="Harf Duyarlılığı"
                              ToolTip="Girdiğiniz metinlerin BÜYÜK/küçük harf dönüşüm tercihini belirleyin (kişisel ayar)."
                              Click="OpenTextCaseSettings_Click"/>
                </MenuItem>
                <MenuItem Header="Log Klasörünü Aç"
                          ToolTip="Uygulama loglarının bulunduğu klasörü açar."
                          Click="OpenLogDirectory_Click"/>
            </MenuItem>
        </Menu>

        <!-- Nakit islemler icerigi UserControl'e tasindi (Faz D pilot).
             MainWindow yalnizca menu, cikis ve baslangic islerini tutar.

             Ekran kod arkasinda uretilir: kurucusu IServiceProvider aliyor ve
             XAML parametresiz kurucu ister. Ayni ekran ileride ShellWindow
             icinde de ayni sekilde barinacak. -->
        <ContentControl x:Name="ScreenHost"/>

    </DockPanel>
</Window>
