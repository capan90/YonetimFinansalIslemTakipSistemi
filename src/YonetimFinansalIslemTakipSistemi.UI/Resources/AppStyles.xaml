<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:YonetimFinansalIslemTakipSistemi.UI.Converters"
                    xmlns:common="clr-namespace:YonetimFinansalIslemTakipSistemi.UI.Common">

    <!-- ── Converter ───────────────────────────────────────────────────────────
         Fırça DÖNDÜREN converter'lar kaldırıldı (SystemLogLevelToColorConverter,
         BoolToStatusColorConverter, DecimalToColorConverter). Hepsi aynı hatayı
         paylaşıyordu: converter bağlama başına bir kez çalışır, döndürdüğü Brush
         örneği donar ve tema değiştiğinde güncellenmez. Yerlerini XAML'deki
         DataTrigger + DynamicResource desenleri aldı.
         Geriye yalnızca veri→durum çeviren (renk taşımayan) converter kaldı. -->
    <converters:DecimalToSignConverter x:Key="DecimalSign"/>

    <!-- ══ TİPOGRAFİ ÖLÇEĞİ ══════════════════════════════════════════════════
         Altı adım. XAML'de serbest FontSize yazılmaz; bu stillerden biri kullanılır.
         Boyutlar 14 taban üzerine kuruludur, satır yükseklikleri ~1.4 orandadır.

           Text.Display    28/34 Bold      dashboard hero rakamı, bakiye tutarı
           Text.H1         20/28 Bold      pencere başlığı
           Text.H2         16/24 SemiBold  bölüm / kart başlığı
           Text.Body       14/21 Regular   tablo hücresi, form etiketi  (taban)
           Text.BodyStrong 14/21 SemiBold  sütun başlığı, vurgulu gövde
           Text.Caption    12/18 Medium    kart etiketi, ipucu, zaman damgası
    ═══════════════════════════════════════════════════════════════════════ -->

    <!-- Taban font pencere seviyesinden miras alınır; alt öğeler override edebilir.
         Segoe UI Variable Text = Win11 metin optiği, Win10'da Segoe UI'ye düşer.
         Zincirin sonundaki Segoe UI Emoji, arayüzdeki emoji karakterlerinin
         kutu görünmesini engeller. -->
    <Style TargetType="{x:Type Window}">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Segoe UI Emoji"/>
        <Setter Property="FontSize"   Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
        <!-- Faz B'nin en büyük koyu tema kırılması buradaydı: Foreground temaya
             bağlanmış ama Background bağlanmamıştı. Background'u ayarlamayan bir
             Window, WPF'te SystemColors.WindowBrush'a (BEYAZ) düşer. Koyu temada
             açık metin beyaz zemine biniyor ve pencere içeriği kayboluyordu.
             43 XAML'in 31'i kök panelinde zemin vermiyor — hepsi bundan etkilendi. -->
        <Setter Property="Background" Value="{DynamicResource Theme.AppBackground}"/>
    </Style>

    <Style x:Key="Text.Display" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="28"/>
        <Setter Property="LineHeight" Value="34"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <!-- Tabular: rakam genişlikleri eşit → alt alta duran tutarların hane hizası kaymaz -->
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>

    <Style x:Key="Text.H1" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="20"/>
        <Setter Property="LineHeight" Value="28"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="Text.H2" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="16"/>
        <Setter Property="LineHeight" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="14"/>
        <Setter Property="LineHeight" Value="21"/>
    </Style>

    <Style x:Key="Text.BodyStrong" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="Text.Caption" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="12"/>
        <Setter Property="LineHeight" Value="18"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource Theme.LabelText}"/>
    </Style>

    <!-- ── Bakiye tutarı ─────────────────────────────────────────────────────
         Pozitif yeşil / negatif kırmızı / sıfır nötr. Renk artık converter'dan
         DEĞİL, DataTrigger + DynamicResource ile gelir → tema değişiminde
         anında güncellenir.
         Kullanım: Tag'e işaret ("Positive"/"Negative"/"Zero") bağlanır; her kart
         kendi bakiyesini gösterdiği için tetikleyici bağlama yolu stile
         gömülemez, kontrolün kendi Tag'i üzerinden okunur. -->
    <Style x:Key="Text.BalanceAmount" TargetType="TextBlock" BasedOn="{StaticResource Text.Display}">
        <Setter Property="Foreground" Value="{DynamicResource Theme.LabelText}"/>
        <Style.Triggers>
            <Trigger Property="Tag" Value="Positive">
                <Setter Property="Foreground" Value="{DynamicResource Theme.Success}"/>
            </Trigger>
            <Trigger Property="Tag" Value="Negative">
                <Setter Property="Foreground" Value="{DynamicResource Theme.Danger}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ── Kırpılan metin hücresi ───────────────────────────────────────────
         Uzun açıklama/firma adları kolon dışına taşmak yerine "..." ile kırpılır;
         yalnızca gerçekten kırpıldığında tam değeri gösteren ToolTip kurulur
         (bkz. Common/TextTrimmingToolTip.cs).
         Sayısal kolonlar NumericCell kullanmaya devam eder — kırpma orada
         rakam kaybına yol açardı. -->
    <Style x:Key="EllipsisCell" TargetType="TextBlock">
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="common:TextTrimmingToolTip.Enabled" Value="True"/>
    </Style>

    <!-- ── Sayısal hücre ────────────────────────────────────────────────────
         Para/tutar gösteren DataGrid kolonları bunu BasedOn ile kullanır.
         Sağa hizalı + tabular rakam: hane hizası korunur, göz kolon boyunca kayar. -->
    <Style x:Key="NumericCell" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment"         Value="Right"/>
        <Setter Property="Padding"                     Value="0,0,4,0"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>

    <!-- ── Boş liste (empty state) metni ─────────────────────────────────────
         Kullanım: DataGrid'in üzerine bindirilen TextBlock bu stile BasedOn olur;
         görünürlük tetikleyicisi (Items.Count=0) ElementName gerektirdiği için
         pencere içinde tanımlanır. -->
    <Style x:Key="EmptyStateText" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment"   Value="Center"/>
        <Setter Property="Foreground"          Value="{DynamicResource Theme.MutedText}"/>
        <Setter Property="IsHitTestVisible"    Value="False"/>
        <Setter Property="Visibility"          Value="Collapsed"/>
    </Style>

    <!-- ── Grafik metinleri (Faz C) ──────────────────────────────────────────
         Grafik KONTROL stilleri Resources/ChartPalette.xaml'dedir; bu üçü
         burada durur çünkü Text.* ölçeğine BasedOn ile dayanıyorlar ve BasedOn
         kardeş sözlükler arası StaticResource'u güvenilir çözemiyor. -->
    <Style x:Key="Chart.Title" TargetType="TextBlock" BasedOn="{StaticResource Text.H2}">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Primary}"/>
        <Setter Property="Margin"     Value="0,0,0,8"/>
    </Style>

    <!-- Grafiğin ne anlattığını yazan alt satır. Renk tek başına anlam taşımaz;
         özellikle büyüklük skalasında okuyucunun neye baktığını bilmesi gerekir. -->
    <Style x:Key="Chart.Caption" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
        <Setter Property="Foreground"   Value="{DynamicResource Theme.MutedText}"/>
        <Setter Property="Margin"       Value="0,6,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Veri yoksa grafik yerine bu gösterilir; boş eksen çizmek "sıfır değer"
         izlenimi verir. Görünürlüğü kullanan pencere DataTrigger ile yönetir. -->
    <Style x:Key="Chart.EmptyState" TargetType="TextBlock" BasedOn="{StaticResource EmptyStateText}">
        <Setter Property="Margin" Value="0,24"/>
    </Style>

    <!-- ── Odak halkası ─────────────────────────────────────────────────────
         WPF'in varsayılan noktalı odak dikdörtgeni koyu zeminde kaybolur ve
         klavyeyle gezerken nerede olunduğu anlaşılmaz. Ortak halka: 2px marka
         rengi çerçeve, kontrolün 2px dışında.
         Not: DataGridCell bilinçli olarak FocusVisualStyle={x:Null} kullanır —
         hücre bazlı halka satır seçimiyle çakışıyordu. -->
    <Style x:Key="AppFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2"
                               StrokeThickness="2"
                               Stroke="{DynamicResource Theme.PrimaryHover}"
                               RadiusX="4" RadiusY="4"
                               SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- DatePicker / ComboBox / Menu / Button gibi kontrollerin tam şablonları
         Resources/Controls.xaml içindedir. Buradaki setter'lar yeterli değildi:
         WPF'in yerleşik şablonları renkleri sabit hex olarak taşıyor ve
         Background/Foreground setter'ları o sabitlerin üzerine geçmiyordu. -->

    <!-- Brush.* sabit fırçaları KALDIRILDI (Faz B).
         11 adet sabit renkli SolidColorBrush idi; XAML'de de code-behind'da da
         hiçbir referansı kalmamıştı. StaticResource oldukları için tema
         değişiminde güncellenmiyorlardı — durmaları koyu tema için tuzaktı.
         Karşılıkları: Brush.Primary→Theme.Primary, Brush.Border→Theme.Border,
         Brush.TextPrimary→Theme.Text, Brush.TextSecondary→Theme.MutedText vb. -->

    <!-- ── Buton Stilleri ────────────────────────────────────────────────────── -->

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background"      Value="{DynamicResource Theme.Primary}"/>
        <Setter Property="Foreground"      Value="{DynamicResource Theme.OnPrimary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Height"          Value="32"/>
        <Setter Property="Padding"         Value="14,0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="FontSize"        Value="14"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.PrimaryHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.PrimaryPressed}"/>
                        </Trigger>
                        <!-- Devre dışı: #94A3B8 + Opacity 0.7 beyaz metinle 2.1:1 veriyordu.
                             Opaklık kaldırıldı, zemin koyulaştırıldı → 4.6:1 (WCAG AA). -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.DisabledBackground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Background"      Value="{DynamicResource Theme.Secondary}"/>
        <Setter Property="Foreground"      Value="{DynamicResource Theme.OnSecondary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Height"          Value="32"/>
        <Setter Property="Padding"         Value="14,0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="FontSize"        Value="14"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.SecondaryHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.SecondaryPressed}"/>
                        </Trigger>
                        <!-- Devre dışı: #94A3B8 + Opacity 0.7 beyaz metinle 2.1:1 veriyordu.
                             Opaklık kaldırıldı, zemin koyulaştırıldı → 4.6:1 (WCAG AA). -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.DisabledBackground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button">
        <Setter Property="Background"      Value="{DynamicResource Theme.Danger}"/>
        <Setter Property="Foreground"      Value="{DynamicResource Theme.OnDanger}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Height"          Value="32"/>
        <Setter Property="Padding"         Value="14,0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="FontSize"        Value="14"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.DangerHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.DangerPressed}"/>
                        </Trigger>
                        <!-- Devre dışı: #94A3B8 + Opacity 0.7 beyaz metinle 2.1:1 veriyordu.
                             Opaklık kaldırıldı, zemin koyulaştırıldı → 4.6:1 (WCAG AA). -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.DisabledBackground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Metin girişi ortak şablonu ────────────────────────────────────────
         WPF'in yerleşik TextBox şablonu devre dışı durumda zemini #F0F0F0'a,
         metni #838383'e SABİTLER. Koyu temada bu, açık gri kutu içinde gri
         metin demekti. Ayrıca seçim rengi (SelectionBrush) tanımlı olmadığı
         için yazılan metin seçilince sistem mavisi + koyu metin çakışıyor ve
         "yazdığım yazı kayboldu" görüntüsü oluşuyordu.
         Şablon PART_ContentHost adını korur — metin girişi oraya yerleşir. -->
    <ControlTemplate x:Key="InputFieldTemplate" TargetType="{x:Type Control}">
        <Border x:Name="Bd"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="4"
                SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost"
                          Margin="{TemplateBinding Padding}"
                          VerticalAlignment="Center"
                          Focusable="False"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Hidden"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Theme.InputBorderFocus}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Theme.InputBorderFocus}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Background"  Value="{DynamicResource Theme.Input.DisabledBackground}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Theme.Border}"/>
                <Setter Property="Foreground" Value="{DynamicResource Theme.Input.DisabledForeground}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- ── TextBox ──────────────────────────────────────────────────────────── -->
    <Style TargetType="{x:Type TextBox}">
        <Setter Property="Padding"                  Value="6,4"/>
        <Setter Property="BorderBrush"              Value="{DynamicResource Theme.InputBorder}"/>
        <Setter Property="BorderThickness"          Value="1"/>
        <Setter Property="Background"               Value="{DynamicResource Theme.InputBackground}"/>
        <Setter Property="Foreground"               Value="{DynamicResource Theme.Text}"/>
        <Setter Property="CaretBrush"               Value="{DynamicResource Theme.Text}"/>
        <Setter Property="SelectionBrush"           Value="{DynamicResource Theme.Input.SelectionBackground}"/>
        <Setter Property="SelectionTextBrush"       Value="{DynamicResource Theme.Input.SelectionForeground}"/>
        <Setter Property="SelectionOpacity"         Value="1"/>
        <Setter Property="MinHeight"                Value="28"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle"         Value="{StaticResource AppFocusVisual}"/>
        <Setter Property="Template"                 Value="{StaticResource InputFieldTemplate}"/>
        <Style.Triggers>
            <!-- Salt okunur alan devre dışı DEĞİLDİR: metin tam kontrastta kalır,
                 yalnızca zemin "düzenlenemez" olduğunu söyler -->
            <Trigger Property="IsReadOnly" Value="True">
                <Setter Property="Background" Value="{DynamicResource Theme.Input.ReadOnlyBackground}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ── PasswordBox ──────────────────────────────────────────────────────── -->
    <Style TargetType="{x:Type PasswordBox}">
        <Setter Property="Padding"                  Value="6,4"/>
        <Setter Property="BorderBrush"              Value="{DynamicResource Theme.InputBorder}"/>
        <Setter Property="BorderThickness"          Value="1"/>
        <Setter Property="Background"               Value="{DynamicResource Theme.InputBackground}"/>
        <Setter Property="Foreground"               Value="{DynamicResource Theme.Text}"/>
        <Setter Property="CaretBrush"               Value="{DynamicResource Theme.Text}"/>
        <Setter Property="SelectionBrush"           Value="{DynamicResource Theme.Input.SelectionBackground}"/>
        <Setter Property="SelectionTextBrush"       Value="{DynamicResource Theme.Input.SelectionForeground}"/>
        <Setter Property="SelectionOpacity"         Value="1"/>
        <Setter Property="MinHeight"                Value="28"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle"         Value="{StaticResource AppFocusVisual}"/>
        <Setter Property="Template"                 Value="{StaticResource InputFieldTemplate}"/>
    </Style>

    <!-- ComboBox stili Resources/Controls.xaml'e taşındı: yalnızca renk
         setter'ları yetmiyordu, tam şablon gerekiyor (açılır liste ayrı yüzey). -->

    <!-- ── DataGrid ──────────────────────────────────────────────────────────── -->
    <!-- SelectionUnit="FullRow": tıklamada tüm satır hücreleri seçilir.
         Seçim rengi DataGridCell trigger üzerinden uygulanır — AlternatingRowBackground
         satıra local value koyduğu için DataGridRow trigger etkisiz kalır;
         DataGridCell trigger local value taşımaz, dolayısıyla güvenilir çalışır. -->
    <Style TargetType="{x:Type DataGrid}">
        <Setter Property="HeadersVisibility"    Value="Column"/>
        <Setter Property="SelectionUnit"        Value="FullRow"/>
        <!-- 36: 14px gövde metni + rahat dokunma alanı. Tek yerden yönetilir;
             pencerelerdeki satır yüksekliği tekrarları kaldırıldı. -->
        <Setter Property="RowHeight"            Value="36"/>
        <Setter Property="FontSize"             Value="14"/>
        <Setter Property="Background"           Value="{DynamicResource Theme.DataGridRow}"/>
        <Setter Property="RowBackground"        Value="{DynamicResource Theme.DataGridRow}"/>
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource Theme.DataGridAltRow}"/>
        <Setter Property="Foreground"           Value="{DynamicResource Theme.Text}"/>
        <Setter Property="BorderBrush"          Value="{DynamicResource Theme.Border}"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Theme.Border}"/>
        <Setter Property="VerticalGridLinesBrush"   Value="{DynamicResource Theme.Border}"/>
    </Style>

    <Style TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Background"                 Value="{DynamicResource Theme.DataGridHeader}"/>
        <Setter Property="Foreground"                 Value="{DynamicResource Theme.DataGridHeaderText}"/>
        <!-- Sütun başlığı = Text.BodyStrong ile aynı ölçek (14/SemiBold) -->
        <Setter Property="FontWeight"                 Value="SemiBold"/>
        <Setter Property="FontSize"                   Value="14"/>
        <Setter Property="Padding"                    Value="8,7"/>
        <Setter Property="BorderBrush"                Value="{DynamicResource Theme.Border}"/>
        <Setter Property="BorderThickness"            Value="0,0,1,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Cursor"                     Value="Arrow"/>
    </Style>

    <Style TargetType="{x:Type DataGridRow}">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground"      Value="{DynamicResource Theme.Text}"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Theme.DataGridSelectedRow}"/>
                <Setter Property="Foreground" Value="{DynamicResource Theme.DataGridSelectedText}"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True"/>
                    <Condition Property="IsSelected"  Value="False"/>
                </MultiTrigger.Conditions>
                <MultiTrigger.Setters>
                    <Setter Property="Background" Value="{DynamicResource Theme.DataGridHoverRow}"/>
                </MultiTrigger.Setters>
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type DataGridCell}">
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground"       Value="{DynamicResource Theme.Text}"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background"  Value="{DynamicResource Theme.DataGridSelectedRow}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Foreground"  Value="{DynamicResource Theme.DataGridSelectedText}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
