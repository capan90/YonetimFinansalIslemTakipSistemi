<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    ══════════════════════════════════════════════════════════════════════════
    KONTROL KABUĞU — tema uyumlu şablonlar

    NEDEN VAR:
    Faz B token'ları XAML'e taşıdı ama kontrollerin ÇOĞU kendi renklerini
    XAML'den almıyor; WPF'in yerleşik (Aero2) şablonundan alıyor. O şablon
    renkleri sabit hex ve sabit SystemColors olarak taşır ve tema sözlüğünü
    hiç görmez. Sonuç: koyu temada

      • Menu / MenuItem  → Aero2 stili Foreground'u #212121'e SABİTLER (setter,
        miras değil). Koyu menü zemini + koyu metin = görünmez menü.
      • Popup / ContextMenu → ayrı visual tree; pencerenin Foreground'unu
        miras ALMAZ, kendi zemini beyaz kalır.
      • ComboBox → kapalı kutunun zemini sabit açık gri gradyan; açılır liste
        SystemColors.WindowBrush (beyaz) iken item metni ComboBox'tan miras
        alınıyor → beyaz üstüne beyaz.
      • Varsayılan Button → sabit açık gradyan, tema değişimini görmez.
      • DatePickerTextBox → kendi beyaz zeminini taşır.

    Bu dosya o kontrollerin şablonlarını tema token'larına bağlar. Yalnızca
    GÖRÜNÜM değişir; parça adları (PART_Popup, PART_EditableTextBox,
    PART_ContentHost, PART_TextBox, PART_Button) WPF'in beklediği gibi korunur —
    aksi halde klavye navigasyonu ve seçim mantığı bozulur.

    Değer önceliği notu: bir ControlTemplate içinde ayarlanan özellik
    ("TemplatedParent template properties") örtük stil setter'larından ÖNCE
    gelir. Bu yüzden aşağıdaki örtük Button stili, DatePicker/Calendar gibi
    şablon içindeki butonların kendi Template'ini EZMEZ.
    ══════════════════════════════════════════════════════════════════════════
    -->

    <!-- ══════════════════════════════════════════════════════════════════════
         KAYDIRMA ÇUBUĞU
         Koyu temada varsayılan açık gri çubuk pencereden fırlıyordu.
    ═══════════════════════════════════════════════════════════════════════ -->

    <Style x:Key="ScrollBar.Thumb" TargetType="{x:Type Thumb}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop"             Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="Bd"
                            Background="{DynamicResource Theme.ScrollBar.Thumb}"
                            CornerRadius="4" Margin="2"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.ScrollBar.ThumbHover}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.ScrollBar.ThumbHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ok butonları çizilmez; çubuk sade tutulur (Windows 11 deseni) -->
    <Style x:Key="ScrollBar.HiddenRepeatButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable"             Value="False"/>
        <Setter Property="IsTabStop"             Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Background" Value="{DynamicResource Theme.ScrollBar.Track}"/>
        <Setter Property="Width"      Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollBar.HiddenRepeatButton}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollBar.Thumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollBar.HiddenRepeatButton}"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width"  Value="Auto"/>
                <Setter Property="Height" Value="12"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollBar.HiddenRepeatButton}"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollBar.Thumb}"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollBar.HiddenRepeatButton}"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════════
         MENÜ
    ═══════════════════════════════════════════════════════════════════════ -->

    <!-- Menü çubuğu. Background TemplateBinding'dir: MainWindow kendi zeminini
         verir, Kargo Dashboard'daki yardım menüsü Transparent kalır. -->
    <Style TargetType="{x:Type Menu}">
        <Setter Property="Background" Value="{DynamicResource Theme.Menu.Background}"/>
        <Setter Property="Foreground" Value="{DynamicResource Theme.Menu.Foreground}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Menu}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ItemsPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Menü çubuğundaki üst seviye başlık (alt menüsü VAR).
         Popup ayrı visual tree'de olduğu için renkleri DynamicResource ile
         doğrudan çözülür; pencereden miras beklenemez. -->

    <ControlTemplate x:Key="Menu.TopLevelHeader" TargetType="{x:Type MenuItem}">
        <Border x:Name="Bd"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                Padding="{TemplateBinding Padding}"
                SnapsToDevicePixels="True">
            <Grid>
                <ContentPresenter x:Name="Hdr"
                                  ContentSource="Header"
                                  RecognizesAccessKey="True"
                                  VerticalAlignment="Center"
                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                <Popup x:Name="PART_Popup"
                       AllowsTransparency="True"
                       Focusable="False"
                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                       Placement="Bottom"
                       PlacementTarget="{Binding ElementName=Bd}"
                       VerticalOffset="1">
                    <Border Background="{DynamicResource Theme.Popup.Background}"
                            BorderBrush="{DynamicResource Theme.Popup.Border}"
                            BorderThickness="1"
                            Padding="2"
                            TextElement.Foreground="{DynamicResource Theme.Popup.Foreground}"
                            SnapsToDevicePixels="True">
                        <ItemsPresenter Grid.IsSharedSizeScope="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </Popup>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd"  Property="Background" Value="{DynamicResource Theme.Menu.HoverBackground}"/>
                <Setter TargetName="Hdr" Property="TextElement.Foreground" Value="{DynamicResource Theme.Menu.HoverForeground}"/>
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="Bd"  Property="Background" Value="{DynamicResource Theme.Menu.SelectedBackground}"/>
                <Setter TargetName="Hdr" Property="TextElement.Foreground" Value="{DynamicResource Theme.Menu.SelectedForeground}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Hdr" Property="TextElement.Foreground" Value="{DynamicResource Theme.Menu.DisabledForeground}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Menü çubuğundaki üst seviye komut (alt menüsü YOK) -->
    <ControlTemplate x:Key="Menu.TopLevelItem" TargetType="{x:Type MenuItem}">
        <Border x:Name="Bd"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                Padding="{TemplateBinding Padding}"
                SnapsToDevicePixels="True">
            <ContentPresenter x:Name="Hdr"
                              ContentSource="Header"
                              RecognizesAccessKey="True"
                              VerticalAlignment="Center"
                              TextElement.Foreground="{TemplateBinding Foreground}"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd"  Property="Background" Value="{DynamicResource Theme.Menu.HoverBackground}"/>
                <Setter TargetName="Hdr" Property="TextElement.Foreground" Value="{DynamicResource Theme.Menu.HoverForeground}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Hdr" Property="TextElement.Foreground" Value="{DynamicResource Theme.Menu.DisabledForeground}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Açılır liste içindeki komut -->
    <ControlTemplate x:Key="Menu.SubmenuItem" TargetType="{x:Type MenuItem}">
        <Border x:Name="Bd"
                Background="{TemplateBinding Background}"
                CornerRadius="3"
                Padding="0,1"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuIcon"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGesture"/>
                </Grid.ColumnDefinitions>
                <ContentPresenter x:Name="Icon"
                                  Grid.Column="0"
                                  ContentSource="Icon"
                                  Margin="8,0,4,0"
                                  VerticalAlignment="Center"/>
                <ContentPresenter x:Name="Hdr"
                                  Grid.Column="1"
                                  ContentSource="Header"
                                  RecognizesAccessKey="True"
                                  Margin="4,5,12,5"
                                  VerticalAlignment="Center"
                                  TextElement.Foreground="{DynamicResource Theme.Popup.Foreground}"/>
                <TextBlock x:Name="Gesture"
                           Grid.Column="2"
                           Text="{TemplateBinding InputGestureText}"
                           Margin="0,5,10,5"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Theme.Menu.DisabledForeground}"/>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd"  Property="Background" Value="{DynamicResource Theme.Menu.HoverBackground}"/>
                <Setter TargetName="Hdr" Property="TextElement.Foreground" Value="{DynamicResource Theme.Menu.HoverForeground}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Hdr"     Property="TextElement.Foreground" Value="{DynamicResource Theme.Menu.DisabledForeground}"/>
                <Setter TargetName="Gesture" Property="Foreground"             Value="{DynamicResource Theme.Menu.DisabledForeground}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Açılır liste içindeki alt menü başlığı (ör. Yardım → Kullanıcı Ayarlarım) -->
    <ControlTemplate x:Key="Menu.SubmenuHeader" TargetType="{x:Type MenuItem}">
        <Border x:Name="Bd"
                Background="{TemplateBinding Background}"
                CornerRadius="3"
                Padding="0,1"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuIcon"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ContentPresenter Grid.Column="0"
                                  ContentSource="Icon"
                                  Margin="8,0,4,0"
                                  VerticalAlignment="Center"/>
                <ContentPresenter x:Name="Hdr"
                                  Grid.Column="1"
                                  ContentSource="Header"
                                  RecognizesAccessKey="True"
                                  Margin="4,5,12,5"
                                  VerticalAlignment="Center"
                                  TextElement.Foreground="{DynamicResource Theme.Popup.Foreground}"/>
                <!-- Sağ ok: alt menü olduğunu gösterir -->
                <Path x:Name="Arrow"
                      Grid.Column="2"
                      Margin="0,0,10,0"
                      VerticalAlignment="Center"
                      Data="M 0,0 L 4,4 L 0,8 Z"
                      Fill="{DynamicResource Theme.Popup.Foreground}"/>
                <Popup x:Name="PART_Popup"
                       AllowsTransparency="True"
                       Focusable="False"
                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                       Placement="Right"
                       HorizontalOffset="-2">
                    <Border Background="{DynamicResource Theme.Popup.Background}"
                            BorderBrush="{DynamicResource Theme.Popup.Border}"
                            BorderThickness="1"
                            Padding="2"
                            TextElement.Foreground="{DynamicResource Theme.Popup.Foreground}"
                            SnapsToDevicePixels="True">
                        <ItemsPresenter Grid.IsSharedSizeScope="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </Popup>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd"    Property="Background" Value="{DynamicResource Theme.Menu.HoverBackground}"/>
                <Setter TargetName="Hdr"   Property="TextElement.Foreground" Value="{DynamicResource Theme.Menu.HoverForeground}"/>
                <Setter TargetName="Arrow" Property="Fill"       Value="{DynamicResource Theme.Menu.HoverForeground}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Hdr"   Property="TextElement.Foreground" Value="{DynamicResource Theme.Menu.DisabledForeground}"/>
                <Setter TargetName="Arrow" Property="Fill"       Value="{DynamicResource Theme.Menu.DisabledForeground}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type MenuItem}">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <!-- Aero2'nin sabit #212121 Foreground setter'ının yerini alır -->
        <Setter Property="Foreground"      Value="{DynamicResource Theme.Menu.Foreground}"/>
        <Setter Property="Padding"         Value="10,6"/>
        <Setter Property="Template"        Value="{StaticResource Menu.SubmenuItem}"/>
        <Style.Triggers>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Template" Value="{StaticResource Menu.TopLevelHeader}"/>
            </Trigger>
            <Trigger Property="Role" Value="TopLevelItem">
                <Setter Property="Template" Value="{StaticResource Menu.TopLevelItem}"/>
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{StaticResource Menu.SubmenuHeader}"/>
            </Trigger>
            <Trigger Property="Role" Value="SubmenuItem">
                <Setter Property="Template" Value="{StaticResource Menu.SubmenuItem}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="Background"      Value="{DynamicResource Theme.Popup.Background}"/>
        <Setter Property="Foreground"      Value="{DynamicResource Theme.Popup.Foreground}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource Theme.Popup.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="2"
                            TextElement.Foreground="{DynamicResource Theme.Popup.Foreground}"
                            SnapsToDevicePixels="True">
                        <ItemsPresenter Grid.IsSharedSizeScope="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Menü içi ayraç. Menu/ContextMenu bu anahtarı ADIYLA arar; normal
         Separator stili buraya uygulanmaz. -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
        <Setter Property="Height"     Value="1"/>
        <Setter Property="Margin"     Value="6,4"/>
        <Setter Property="Background" Value="{DynamicResource Theme.Menu.Separator}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Border Background="{TemplateBinding Background}" Height="1"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Serbest (menü dışı) ayraç -->
    <Style TargetType="{x:Type Separator}">
        <Setter Property="Height"     Value="1"/>
        <Setter Property="Background" Value="{DynamicResource Theme.Border}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Border Background="{TemplateBinding Background}" Height="1" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════════
         TOOLTIP
    ═══════════════════════════════════════════════════════════════════════ -->
    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="Background"      Value="{DynamicResource Theme.ToolTip.Background}"/>
        <Setter Property="Foreground"      Value="{DynamicResource Theme.ToolTip.Foreground}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource Theme.ToolTip.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="8,5"/>
        <Setter Property="MaxWidth"        Value="420"/>
        <Setter Property="HasDropShadow"   Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToolTip}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <!-- ToolTip içeriği düz string'dir; ContentPresenter onu bir
                             TextBlock'a sarar. TextWrapping eklenmiş özellik olmadığı
                             için o TextBlock'a örtük stille ulaşılır. -->
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════════
         VARSAYILAN (NÖTR) BUTON
         Primary/Secondary/Danger stillerinden birini almayan ~50 buton buraya
         düşer. Şablon veriliyor çünkü Aero2 varsayılanı sabit gradyanlıdır.
    ═══════════════════════════════════════════════════════════════════════ -->
    <Style TargetType="{x:Type Button}">
        <Setter Property="Background"       Value="{DynamicResource Theme.Button.Background}"/>
        <Setter Property="Foreground"       Value="{DynamicResource Theme.Button.Foreground}"/>
        <Setter Property="BorderBrush"      Value="{DynamicResource Theme.Button.Border}"/>
        <Setter Property="BorderThickness"  Value="1"/>
        <Setter Property="Padding"          Value="12,4"/>
        <Setter Property="MinHeight"        Value="28"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{DynamicResource AppFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="Cp"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Button.HoverBackground}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Button.PressedBackground}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background"  Value="{DynamicResource Theme.Button.DisabledBackground}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Theme.Button.DisabledBorder}"/>
                            <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{DynamicResource Theme.Button.DisabledForeground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════════
         NAVİGASYON BUTONU (Kargo Dashboard üst şeridi)
         Şerit her iki temada da koyu marka bandıdır; butonlar oradan renk alır.
         Örtük Button stili kullanılsaydı hover'da nötr gri gelir ve şeritten
         kopardı — bu yüzden ayrı rol seti.
    ═══════════════════════════════════════════════════════════════════════ -->
    <Style x:Key="NavButton" TargetType="{x:Type Button}">
        <Setter Property="Background"       Value="{DynamicResource Theme.Nav.ItemBackground}"/>
        <Setter Property="Foreground"       Value="{DynamicResource Theme.Nav.Foreground}"/>
        <Setter Property="BorderBrush"      Value="{DynamicResource Theme.Nav.ItemBorder}"/>
        <Setter Property="BorderThickness"  Value="1"/>
        <Setter Property="Height"           Value="28"/>
        <Setter Property="Padding"          Value="12,0"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{DynamicResource AppFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="Cp"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Nav.HoverBackground}"/>
                            <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{DynamicResource Theme.Nav.HoverForeground}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Nav.ActiveBackground}"/>
                            <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{DynamicResource Theme.Nav.ActiveForeground}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background"  Value="{DynamicResource Theme.Button.DisabledBackground}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Theme.Button.DisabledBorder}"/>
                            <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{DynamicResource Theme.Button.DisabledForeground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Navigasyon şeridindeki menü başlığı — üst seviye MenuItem'ın nav rolüyle
         boyanmış hâli. Açılan liste normal popup yüzeyini kullanır. -->
    <Style x:Key="NavMenuItem" TargetType="{x:Type MenuItem}">
        <Setter Property="Background"      Value="{DynamicResource Theme.Nav.ItemBackground}"/>
        <Setter Property="Foreground"      Value="{DynamicResource Theme.Nav.Foreground}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource Theme.Nav.ItemBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="12,5"/>
        <Setter Property="Height"          Value="28"/>
        <Setter Property="Template"        Value="{StaticResource Menu.TopLevelHeader}"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════════
         LABEL
         57 kullanım. Aero2 Label'ı Foreground'u SystemColors.ControlTextBrush'a
         bağlar; tema sözlüğünde karşılığı override edilse bile filtre
         etiketlerinin rolü "etiket metni"dir, gövde metni değil.
    ═══════════════════════════════════════════════════════════════════════ -->
    <Style TargetType="{x:Type Label}">
        <Setter Property="Foreground" Value="{DynamicResource Theme.LabelText}"/>
        <Setter Property="Padding"    Value="0,0,6,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Label}">
                    <Border Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter RecognizesAccessKey="True"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Theme.Button.DisabledForeground}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════════
         COMBOBOX
         Kapalı kutu ve açılır liste AYRI yüzeylerdir; ikisi de ayrı token alır.
         IsEditable=True kullanımı var (Kargo Kayıt Düzenleme) — PART_EditableTextBox
         şablonda tanımlı olmak zorunda, yoksa düzenlenebilir mod çöker.
    ═══════════════════════════════════════════════════════════════════════ -->

    <Style x:Key="ComboBox.ToggleButton" TargetType="{x:Type ToggleButton}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable"             Value="False"/>
        <Setter Property="IsTabStop"             Value="False"/>
        <Setter Property="ClickMode"             Value="Press"/>
        <Setter Property="Background"            Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Background"                  Value="Transparent"/>
        <Setter Property="Foreground"                  Value="{DynamicResource Theme.ComboBox.DropdownForeground}"/>
        <Setter Property="Padding"                     Value="8,5"/>
        <Setter Property="HorizontalContentAlignment"  Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="3"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="Cp"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.ComboBox.ItemHoverBackground}"/>
                            <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{DynamicResource Theme.ComboBox.ItemHoverForeground}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.ComboBox.ItemSelectedBackground}"/>
                            <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{DynamicResource Theme.ComboBox.ItemSelectedForeground}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{DynamicResource Theme.Menu.DisabledForeground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="ComboBox.Template" TargetType="{x:Type ComboBox}">
        <Grid>
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                    </Grid.ColumnDefinitions>

                    <!-- Kapalı haldeki seçili değer.
                         DÖRT bağlama da zorunludur; biri eksikse seçili öğe
                         nesnenin ToString()'i olarak görünür.

                         ContentTemplateSelector özellikle kritiktir:
                         SelectionBoxItemTemplate, DisplayMemberPath'i TAŞIMAZ
                         (o durumda null kalır — WPF'in kendi şablonunda da öyle).
                         DisplayMemberPath atandığında ItemsControl dahili bir
                         DisplayMemberTemplateSelector üretip ItemTemplateSelector'a
                         koyar; kapalı alana ulaşmasının TEK yolu budur.
                         Bu bağlama atlanınca ComboBox'lar "ComboItem { Label = ... }"
                         gösteriyordu. -->
                    <ContentPresenter x:Name="ContentSite"
                                      Grid.Column="0"
                                      Margin="8,0,4,0"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left"
                                      IsHitTestVisible="False"
                                      Content="{TemplateBinding SelectionBoxItem}"
                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                      TextElement.Foreground="{TemplateBinding Foreground}"/>

                    <!-- Düzenlenebilir mod: WPF bu parçayı ADIYLA arar -->
                    <TextBox x:Name="PART_EditableTextBox"
                             Grid.Column="0"
                             Margin="5,0,2,0"
                             Padding="0"
                             VerticalContentAlignment="Center"
                             Background="Transparent"
                             Foreground="{TemplateBinding Foreground}"
                             CaretBrush="{TemplateBinding Foreground}"
                             SelectionBrush="{DynamicResource Theme.Input.SelectionBackground}"
                             SelectionTextBrush="{DynamicResource Theme.Input.SelectionForeground}"
                             BorderThickness="0"
                             Focusable="True"
                             Visibility="Hidden"
                             IsReadOnly="{TemplateBinding IsReadOnly}"/>

                    <ToggleButton Grid.ColumnSpan="2"
                                  Style="{StaticResource ComboBox.ToggleButton}"
                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>

                    <Path x:Name="Arrow"
                          Grid.Column="1"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Data="M 0,0 L 8,0 L 4,5 Z"
                          Fill="{TemplateBinding Foreground}"
                          IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <Popup x:Name="PART_Popup"
                   AllowsTransparency="True"
                   Focusable="False"
                   IsOpen="{TemplateBinding IsDropDownOpen}"
                   Placement="Bottom"
                   PopupAnimation="Fade">
                <Border x:Name="DropDownBd"
                        MinWidth="{Binding ActualWidth, ElementName=Bd}"
                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                        Background="{DynamicResource Theme.ComboBox.DropdownBackground}"
                        BorderBrush="{DynamicResource Theme.Popup.Border}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Margin="0,1,0,0"
                        TextElement.Foreground="{DynamicResource Theme.ComboBox.DropdownForeground}"
                        SnapsToDevicePixels="True">
                    <ScrollViewer Padding="2" SnapsToDevicePixels="True">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                    </ScrollViewer>
                </Border>
            </Popup>
        </Grid>

        <ControlTemplate.Triggers>
            <Trigger Property="IsEditable" Value="True">
                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                <Setter TargetName="ContentSite"          Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Theme.InputBorderFocus}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Theme.InputBorderFocus}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd"          Property="Background" Value="{DynamicResource Theme.Input.DisabledBackground}"/>
                <Setter TargetName="ContentSite" Property="TextElement.Foreground" Value="{DynamicResource Theme.Input.DisabledForeground}"/>
                <Setter TargetName="Arrow"       Property="Fill" Value="{DynamicResource Theme.Input.DisabledForeground}"/>
            </Trigger>
            <Trigger Property="HasItems" Value="False">
                <Setter TargetName="DropDownBd" Property="MinHeight" Value="24"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="Background"       Value="{DynamicResource Theme.InputBackground}"/>
        <Setter Property="Foreground"       Value="{DynamicResource Theme.Text}"/>
        <Setter Property="BorderBrush"      Value="{DynamicResource Theme.InputBorder}"/>
        <Setter Property="BorderThickness"  Value="1"/>
        <Setter Property="MinHeight"        Value="28"/>
        <Setter Property="FocusVisualStyle" Value="{DynamicResource AppFocusVisual}"/>
        <Setter Property="Template"         Value="{StaticResource ComboBox.Template}"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════════
         LISTBOX
    ═══════════════════════════════════════════════════════════════════════ -->
    <Style TargetType="{x:Type ListBox}">
        <Setter Property="Background"      Value="{DynamicResource Theme.InputBackground}"/>
        <Setter Property="Foreground"      Value="{DynamicResource Theme.Text}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource Theme.InputBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style TargetType="{x:Type ListBoxItem}">
        <Setter Property="Background"                 Value="Transparent"/>
        <Setter Property="Foreground"                 Value="{DynamicResource Theme.Text}"/>
        <Setter Property="Padding"                    Value="6,3"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="3"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="Cp"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.DataGridHoverRow}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.DataGridSelectedRow}"/>
                            <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{DynamicResource Theme.DataGridSelectedText}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════════
         CHECKBOX / RADIOBUTTON
         Aero2 kutuyu sabit beyaz zemin + sabit gri kenarlıkla çizer; koyu
         temada işaretsiz kutu görünmez oluyordu.
    ═══════════════════════════════════════════════════════════════════════ -->
    <Style TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground"       Value="{DynamicResource Theme.Text}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{DynamicResource AppFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box"
                                Width="16" Height="16"
                                VerticalAlignment="Center"
                                Margin="0,0,6,0"
                                CornerRadius="3"
                                Background="{DynamicResource Theme.InputBackground}"
                                BorderBrush="{DynamicResource Theme.InputBorder}"
                                BorderThickness="1"
                                SnapsToDevicePixels="True">
                            <Path x:Name="Check"
                                  Width="10" Height="10"
                                  Stretch="Uniform"
                                  Visibility="Collapsed"
                                  Data="M 0,5 L 4,9 L 10,1"
                                  Stroke="{DynamicResource Theme.OnPrimary}"
                                  StrokeThickness="2"
                                  StrokeEndLineCap="Round"
                                  StrokeStartLineCap="Round"/>
                        </Border>
                        <ContentPresenter x:Name="Cp"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box"   Property="Background"  Value="{DynamicResource Theme.Primary}"/>
                            <Setter TargetName="Box"   Property="BorderBrush" Value="{DynamicResource Theme.Primary}"/>
                            <Setter TargetName="Check" Property="Visibility"  Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Theme.InputBorderFocus}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Background"  Value="{DynamicResource Theme.Input.DisabledBackground}"/>
                            <Setter TargetName="Cp"  Property="TextElement.Foreground" Value="{DynamicResource Theme.Input.DisabledForeground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type RadioButton}">
        <Setter Property="Foreground"       Value="{DynamicResource Theme.Text}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{DynamicResource AppFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0">
                            <Ellipse x:Name="Box"
                                     Fill="{DynamicResource Theme.InputBackground}"
                                     Stroke="{DynamicResource Theme.InputBorder}"
                                     StrokeThickness="1"/>
                            <Ellipse x:Name="Dot"
                                     Width="8" Height="8"
                                     Visibility="Collapsed"
                                     Fill="{DynamicResource Theme.Primary}"/>
                        </Grid>
                        <ContentPresenter x:Name="Cp"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Box" Property="Stroke"     Value="{DynamicResource Theme.Primary}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Stroke" Value="{DynamicResource Theme.InputBorderFocus}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Fill" Value="{DynamicResource Theme.Input.DisabledBackground}"/>
                            <Setter TargetName="Cp"  Property="TextElement.Foreground" Value="{DynamicResource Theme.Input.DisabledForeground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════════
         GROUPBOX  (21 kullanım — Analiz, Kargo Dashboard, form pencereleri)
    ═══════════════════════════════════════════════════════════════════════ -->
    <Style TargetType="{x:Type GroupBox}">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Foreground"      Value="{DynamicResource Theme.Text}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource Theme.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="8"/>
        <Setter Property="Margin"          Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                Background="{DynamicResource Theme.SurfaceAlt}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,1,1,0"
                                CornerRadius="4,4,0,0"
                                Padding="10,5">
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{DynamicResource Theme.LabelText}"
                                              TextElement.FontWeight="SemiBold"/>
                        </Border>
                        <Border Grid.Row="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,0,1,1"
                                CornerRadius="0,0,4,4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════════
         PROGRESSBAR  (Excel içe aktarma sihirbazları)
    ═══════════════════════════════════════════════════════════════════════ -->
    <Style TargetType="{x:Type ProgressBar}">
        <Setter Property="Background"      Value="{DynamicResource Theme.SurfaceAlt}"/>
        <Setter Property="Foreground"      Value="{DynamicResource Theme.Primary}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource Theme.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            SnapsToDevicePixels="True">
                        <Grid x:Name="PART_Track" ClipToBounds="True">
                            <Rectangle x:Name="PART_Indicator"
                                       HorizontalAlignment="Left"
                                       Fill="{TemplateBinding Foreground}"
                                       RadiusX="2" RadiusY="2"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════════
         DATEPICKER + TAKVİM
         DatePickerTextBox kendi beyaz zeminini taşır ve örtük TextBox stili
         ona uygulanmaz (farklı tip). Takvim açılır penceresi de ayrı yüzeydir.
    ═══════════════════════════════════════════════════════════════════════ -->
    <Style TargetType="{x:Type DatePickerTextBox}">
        <Setter Property="Background"                Value="Transparent"/>
        <Setter Property="Foreground"                Value="{DynamicResource Theme.Text}"/>
        <Setter Property="CaretBrush"                Value="{DynamicResource Theme.Text}"/>
        <Setter Property="SelectionBrush"            Value="{DynamicResource Theme.Input.SelectionBackground}"/>
        <Setter Property="SelectionTextBrush"        Value="{DynamicResource Theme.Input.SelectionForeground}"/>
        <Setter Property="BorderThickness"           Value="0"/>
        <Setter Property="Padding"                   Value="6,3"/>
        <Setter Property="VerticalContentAlignment"  Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DatePickerTextBox}">
                    <Grid Background="{TemplateBinding Background}">
                        <!-- PART_ContentHost adı zorunlu: metin girişi buraya yerleşir -->
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                        <TextBlock x:Name="PART_Watermark"
                                   Margin="{TemplateBinding Padding}"
                                   VerticalAlignment="Center"
                                   Text="gg.aa.yyyy"
                                   Foreground="{DynamicResource Theme.Input.Placeholder}"
                                   Visibility="Collapsed"
                                   IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Theme.Input.DisabledForeground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DatePicker.CalendarButton" TargetType="{x:Type Button}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable"             Value="False"/>
        <Setter Property="Cursor"                Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd" Background="Transparent" Padding="4,0">
                        <!-- Takvim ikonu: gövde + üst şerit + iki askı -->
                        <Path x:Name="Glyph"
                              Width="14" Height="14"
                              Stretch="Uniform"
                              Stroke="{DynamicResource Theme.LabelText}"
                              StrokeThickness="1.6"
                              Data="M3,5 L21,5 L21,21 L3,21 Z M3,10 L21,10 M8,3 L8,7 M16,3 L16,7"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource Theme.Primary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type DatePicker}">
        <Setter Property="Background"       Value="{DynamicResource Theme.InputBackground}"/>
        <Setter Property="Foreground"       Value="{DynamicResource Theme.Text}"/>
        <Setter Property="BorderBrush"      Value="{DynamicResource Theme.InputBorder}"/>
        <Setter Property="BorderThickness"  Value="1"/>
        <Setter Property="MinHeight"        Value="28"/>
        <Setter Property="FocusVisualStyle" Value="{DynamicResource AppFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DatePicker}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <Grid x:Name="PART_Root">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <DatePickerTextBox x:Name="PART_TextBox"
                                               Grid.Column="0"
                                               Foreground="{TemplateBinding Foreground}"
                                               VerticalContentAlignment="Center"/>

                            <Button x:Name="PART_Button"
                                    Grid.Column="1"
                                    Style="{StaticResource DatePicker.CalendarButton}"
                                    VerticalAlignment="Center"/>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=PART_TextBox}"
                                   StaysOpen="False"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Theme.InputBorderFocus}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Input.DisabledBackground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Takvim açılır penceresi. Kendi şablonu yeniden yazılmaz; yerleşik
         şablon SystemColors anahtarlarını okur ve onlar tema sözlüğünde
         override edilir. Buradaki setter'lar yalnızca dış yüzeyi bağlar. -->
    <Style TargetType="{x:Type Calendar}">
        <Setter Property="Background"      Value="{DynamicResource Theme.Popup.Background}"/>
        <Setter Property="Foreground"      Value="{DynamicResource Theme.Popup.Foreground}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource Theme.Popup.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style TargetType="{x:Type CalendarDayButton}">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Popup.Foreground}"/>
    </Style>

    <Style TargetType="{x:Type CalendarButton}">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Popup.Foreground}"/>
    </Style>

    <Style TargetType="{x:Type CalendarItem}">
        <Setter Property="Background"  Value="{DynamicResource Theme.Popup.Background}"/>
        <Setter Property="Foreground"  Value="{DynamicResource Theme.Popup.Foreground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Popup.Border}"/>
    </Style>

</ResourceDictionary>
