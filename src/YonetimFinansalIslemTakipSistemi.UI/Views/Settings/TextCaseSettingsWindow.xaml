<Window x:Class="YonetimFinansalIslemTakipSistemi.UI.Views.Settings.TextCaseSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Harf Duyarlılığı"
        Height="300" Width="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Assets/AppIcon.ico"
        Loaded="Window_Loaded">

    <DockPanel Margin="20">

        <!-- Kaydet butonu — alt panel -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Theme.Success}"
                       FontSize="11"
                       Margin="0,0,12,0"
                       Visibility="Collapsed"/>
            <Button Content="Kaydet"
                    Click="Save_Click"
                    Width="110" Height="30"
                    Style="{StaticResource PrimaryButton}"/>
            <Button Content="Kapat"
                    IsCancel="True"
                    Width="80" Height="30"
                    Margin="8,0,0,0"
                    Style="{StaticResource SecondaryButton}"/>
        </StackPanel>

        <!-- İçerik -->
        <StackPanel>

            <TextBlock Text="Harf Duyarlılığı"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Theme.Text}"
                       Margin="0,0,0,8"/>

            <DockPanel Margin="0,0,0,12">
                <TextBlock Text="Tercih:"
                           DockPanel.Dock="Left"
                           Width="70"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Theme.Text}"/>
                <ComboBox x:Name="PreferenceCombo"
                          SelectedIndex="0">
                    <ComboBoxItem Content="Olduğu Gibi" Tag="Preserve"/>
                    <ComboBoxItem Content="BÜYÜK HARF" Tag="Uppercase"/>
                    <ComboBoxItem Content="küçük harf" Tag="Lowercase"/>
                </ComboBox>
            </DockPanel>

            <Border Background="{DynamicResource Theme.AppBackground}"
                    BorderBrush="{DynamicResource Theme.Border}"
                    BorderThickness="1" CornerRadius="4"
                    Padding="10,8">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" FontSize="11"
                               Foreground="{DynamicResource Theme.MutedText}"
                               Margin="0,0,0,4">
                        Girdiğiniz metinler (açıklama, firma adı, adres, kişi adları vb.)
                        kaydedilmeden önce bu tercihe göre dönüştürülür. Dönüşüm Türkçe
                        kurallarına göre yapılır (istanbul → İSTANBUL, ışık → IŞIK).
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" FontSize="11"
                               Foreground="{DynamicResource Theme.MutedText}">
                        E-posta, telefon, bağlantı adresi ve otomatik numaralar
                        dönüştürülmez. Tercih yalnızca bundan sonra oluşturulan veya
                        düzenlenen kayıtları etkiler; eski kayıtlar değişmez.
                    </TextBlock>
                </StackPanel>
            </Border>

        </StackPanel>

    </DockPanel>
</Window>
