<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══ İKON SETİ ══════════════════════════════════════════════════════════
         Emoji karakterleri ikon yerine kullanılıyordu. Üç sorun vardı:
           1. Emoji sistem fontundan gelir — tema rengini almaz, koyu temada
              olduğu gibi kalır.
           2. Buton devre dışıyken grileşmez; renkli emoji aktif görünmeye devam eder.
           3. Farklı DPI ölçeklerinde metin taban çizgisine göre kayar.

         Çözüm: 24x24 viewbox üzerine çizilmiş tek çizgi (outline) geometriler.
         Harici paket kullanılmaz; Path.Data string olarak tutulur.

         Kullanım:
           <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Download}"/>

         IconPath, rengi en yakın Button/ContentControl'ün Foreground'undan alır —
         böylece devre dışı ve koyu tema durumları otomatik doğru olur.
    ═══════════════════════════════════════════════════════════════════════════ -->

    <Geometry x:Key="Icon.Download">M12 3 V15 M7 10 L12 15 L17 10 M4 20 H20</Geometry>
    <Geometry x:Key="Icon.Bolt">M13 2 L5 13 H11 L10 22 L19 11 H13 Z</Geometry>
    <Geometry x:Key="Icon.User">M8 8 a4 4 0 1 0 8 0 a4 4 0 1 0 -8 0 M4 21 C4 17 7.6 15 12 15 C16.4 15 20 17 20 21</Geometry>
    <Geometry x:Key="Icon.Lock">M6 11 H18 V21 H6 Z M8.5 11 V7.5 a3.5 3.5 0 0 1 7 0 V11</Geometry>
    <Geometry x:Key="Icon.ChevronDown">M6 9 L12 15 L18 9</Geometry>
    <Geometry x:Key="Icon.Refresh">M20 12 a8 8 0 1 1 -2.6 -5.9 M20 3 V7 H16</Geometry>
    <Geometry x:Key="Icon.Search">M5 11 a6 6 0 1 0 12 0 a6 6 0 1 0 -12 0 M15.5 15.5 L21 21</Geometry>
    <Geometry x:Key="Icon.Plus">M12 5 V19 M5 12 H19</Geometry>
    <Geometry x:Key="Icon.Edit">M4 20 H8 L19 9 a2.1 2.1 0 0 0 -4 -4 L4 16 Z M14 6 L18 10</Geometry>
    <Geometry x:Key="Icon.Copy">M9 9 H20 V20 H9 Z M15 9 V4 H4 V15 H9</Geometry>
    <Geometry x:Key="Icon.Trash">M4 7 H20 M9 7 V4 H15 V7 M6 7 L7 21 H17 L18 7 M10 11 V17 M14 11 V17</Geometry>
    <Geometry x:Key="Icon.Filter">M3 5 H21 L14 13 V20 L10 18 V13 Z</Geometry>

    <!-- 16px kutu; renk sahibi kontrolün Foreground'undan gelir.
         Fill değil Stroke: geometriler tek çizgi (outline) olarak çizilmiştir. -->
    <Style x:Key="IconPath" TargetType="Path">
        <Setter Property="Width"               Value="16"/>
        <Setter Property="Height"              Value="16"/>
        <Setter Property="Stretch"             Value="Uniform"/>
        <Setter Property="StrokeThickness"     Value="1.8"/>
        <Setter Property="StrokeLineJoin"      Value="Round"/>
        <Setter Property="StrokeStartLineCap"  Value="Round"/>
        <Setter Property="StrokeEndLineCap"    Value="Round"/>
        <Setter Property="VerticalAlignment"   Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Stroke"
                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"/>
    </Style>

    <!-- TextBlock/Label yanında duran, kontrol Foreground'u olmayan bağımsız ikon -->
    <Style x:Key="IconPath.Standalone" TargetType="Path" BasedOn="{StaticResource IconPath}">
        <Setter Property="Stroke" Value="{DynamicResource Theme.Text}"/>
    </Style>

    <!-- İkon + metin yan yana: buton içeriklerinde tekrar eden düzen -->
    <Style x:Key="IconTextPanel" TargetType="StackPanel">
        <Setter Property="Orientation"          Value="Horizontal"/>
        <Setter Property="HorizontalAlignment"  Value="Center"/>
        <Setter Property="VerticalAlignment"    Value="Center"/>
    </Style>

</ResourceDictionary>
