<Window x:Class="YonetimFinansalIslemTakipSistemi.UI.Views.Cargo.CargoDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="Kargo Dashboard"
        Width="1100" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Icon="pack://application:,,,/Assets/AppIcon.ico">

    <DockPanel>

        <!-- Üst: Navigasyon çubuğu — yetkiye göre kargo ekranlarına erişim -->
        <Border x:Name="NavBar" DockPanel.Dock="Top"
                Background="{DynamicResource Theme.Nav.Background}" Padding="10,6">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="NavGelenButton"
                            Content="Gelen Kargolar"
                            Style="{StaticResource NavButton}" Margin="0,0,6,0"
                            Click="NavGelenButton_Click"/>
                    <Button x:Name="NavGidenButton"
                            Content="Giden Kargolar"
                            Style="{StaticResource NavButton}" Margin="0,0,6,0"
                            Click="NavGidenButton_Click"/>
                    <Button x:Name="NavFirmaRehberiButton"
                            Content="Firma Rehberi"
                            Style="{StaticResource NavButton}" Margin="0,0,6,0"
                            Click="NavFirmaRehberiButton_Click"/>
                    <Button x:Name="NavKargoFirmalariButton"
                            Content="Kargo Firmaları"
                            Style="{StaticResource NavButton}" Margin="0,0,6,0"
                            Click="NavKargoFirmalariButton_Click"/>
                    <Button x:Name="NavWhatsAppRehberiButton"
                            Content="WhatsApp Rehberi"
                            Style="{StaticResource NavButton}" Margin="0,0,0,0"
                            ToolTip="Tüm kullanıcıların ortak kullandığı WhatsApp alıcı rehberi."
                            Click="NavWhatsAppRehberiButton_Click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <!-- Yardım Menüsü (Yetkiye tabi) -->
                    <!-- Alt öğelerdeki Foreground override'ları KALDIRILDI: Theme.Text
                         pencere yüzeyi içindir, açılan menü ise ayrı bir popup
                         yüzeyidir. Koyu temada açık metin, açık popup zemini
                         üzerine biniyor ve öğeler görünmez oluyordu. Popup metni
                         artık şablondan Theme.Popup.Foreground olarak gelir. -->
                    <Menu x:Name="MenuYardim" Background="Transparent" Margin="0,0,10,0" Visibility="Collapsed">
                        <Menu.Resources>
                            <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="10,6"/>
                            </Style>
                        </Menu.Resources>
                        <MenuItem Style="{StaticResource NavMenuItem}">
                            <MenuItem.Header>
                                <!-- "▾" karakteri yerine vektör chevron: tema rengini alır,
                                     DPI ölçeğinde metin taban çizgisine göre kaymaz -->
                                <StackPanel Style="{StaticResource IconTextPanel}">
                                    <TextBlock Text="Yardım" Margin="0,0,4,0"/>
                                    <Path Style="{StaticResource IconPath}"
                                          Data="{StaticResource Icon.ChevronDown}"
                                          Width="12" Height="12" Stroke="{DynamicResource Theme.Nav.Foreground}"/>
                                </StackPanel>
                            </MenuItem.Header>
                            <!-- Teknik yardım öğeleri CanAccessHelpMenu iznine tabidir (code-behind) -->
                            <MenuItem x:Name="MenuItemCheckUpdates" Header="Güncellemeleri Denetle" Click="CheckUpdates_Click"/>
                            <MenuItem x:Name="MenuItemPersonalMail" Header="Mail Ayarlarım" Click="OpenPersonalMailSettings_Click"/>
                            <MenuItem x:Name="MenuItemLogFolder" Header="Log Klasörünü Aç" Click="OpenLogDirectory_Click"/>
                            <!-- Kişisel kullanıcı ayarları: izin gerektirmez — yalnızca kargo yetkili
                                 kullanıcı da kendi harf tercihine buradan erişir (MainWindow'a geçmeden) -->
                            <MenuItem Header="Kullanıcı Ayarlarım">
                                <MenuItem Header="Harf Duyarlılığı"
                                          Click="OpenTextCaseSettings_Click"
                                          ToolTip="Girdiğiniz metinlerin BÜYÜK/küçük harf dönüşüm tercihini belirleyin (kişisel ayar)."/>
                            </MenuItem>
                        </MenuItem>
                    </Menu>

                    <!-- Çıkış butonu şeritte tek "tehlike" rengidir; dolu Danger
                         zemini + OnDanger metni iki temada da ölçülü çifttir. -->
                    <Button x:Name="NavLogoutButton"
                            Content="Çıkış Yap"
                            Style="{StaticResource DangerButton}"
                            Height="28" Padding="12,0"
                            Click="Logout_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Alt: Kapat butonu -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource Theme.SurfaceSubtle}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="0,1,0,0"
                Padding="12,8">
            <Button x:Name="CloseButton"
                    Content="Kapat"
                    Width="90" Height="30"
                    HorizontalAlignment="Right"
                    Style="{StaticResource SecondaryButton}"
                    Click="CloseButton_Click"/>
        </Border>

        <!-- Ana içerik -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="14,10,14,10">

                <!-- ── Bölüm başlığı: Dashboard ─────────────────── -->
                <DockPanel Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left"
                               Text="Kargo Dashboard"
                               Style="{StaticResource Text.H1}" Foreground="{DynamicResource Theme.Primary}"
                               VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right"
                            x:Name="RefreshDashboardButton"
                            Content="Yenile"
                            Width="70" Height="26"
                            HorizontalAlignment="Right"
                            Style="{StaticResource SecondaryButton}"
                            Click="RefreshDashboardButton_Click"/>
                    <TextBlock DockPanel.Dock="Right"
                               x:Name="DashboardDateBlock"
                               Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Theme.MutedText}"
                               VerticalAlignment="Center" Margin="0,0,8,0"
                               HorizontalAlignment="Right"/>
                </DockPanel>

                <!-- ── 6 Kart ─────────────────────────────────────── -->
                <WrapPanel x:Name="CardsPanel"
                           Orientation="Horizontal"
                           Margin="0,0,0,12">

                    <!-- TIKLANABİLİRLİK NOTU (Faz C bonus):
                         Yalnızca ilk iki kart tıklanabilir. Sebebi doğruluk:
                         rapor filtresi bu ikisinin saydığı kümeyi BİREBİR
                         üretebiliyor (yön + gönderim tarihi = bugün).

                         Diğer dördü üretemiyor:
                           Toplam Bekleyen   → "teslim/iptal dışındaki tüm durumlar";
                                               filtre tek bir durum değeri alıyor
                           Bildirim Bekleyen → yalnızca aktif durumlardaki alt küme
                           Acil Bekleyen     → Acil VEYA Çok Acil (iki değer) + bekliyor
                           Bugün Teslim      → DURUM DEĞİŞİM tarihine göre sayılıyor,
                                               filtre ise gönderim tarihine bakıyor

                         Bu kartları tıklanabilir yapmak, karttaki sayıdan FARKLI
                         bir liste açardı; rakama olan güveni bozar. Filtreyi
                         genişletmek Application katmanı işidir, Faz C kapsamı dışı. -->

                    <!-- Bugün Gelen — tıklanabilir -->
                    <Button x:Name="CardTodayIncoming"
                            Style="{StaticResource CargoCountCard}"
                            Background="{DynamicResource Theme.Info.Background}"
                            BorderBrush="{DynamicResource Theme.Info.Border}"
                            Tag="Incoming" Click="CountCard_Click"
                            ToolTip="Gönderim tarihi bugün olan gelen kargo sayısı. Tıklayın: raporu bu kayıtlara filtreler.">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="CardTodayIncomingVal"
                                       Text="—" Style="{StaticResource Text.Display}"
                                       Foreground="{DynamicResource Theme.Info.Text}"/>
                            <TextBlock Text="Bugün Gelen"
                                       Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Theme.Info.Text}"/>
                        </StackPanel>
                    </Button>

                    <!-- Bugün Giden — tıklanabilir -->
                    <Button Style="{StaticResource CargoCountCard}"
                            Background="{DynamicResource Theme.Success.Background}"
                            BorderBrush="{DynamicResource Theme.Success.Border}"
                            Tag="Outgoing" Click="CountCard_Click"
                            ToolTip="Gönderim tarihi bugün olan giden kargo sayısı. Tıklayın: raporu bu kayıtlara filtreler.">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="CardTodayOutgoingVal"
                                       Text="—" Style="{StaticResource Text.Display}"
                                       Foreground="{DynamicResource Theme.Success.Text}"/>
                            <TextBlock Text="Bugün Giden"
                                       Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Theme.Success.Text}"/>
                        </StackPanel>
                    </Button>

                    <!-- Toplam Bekleyen — tanım CargoShipmentStatusRules.IsPending ile ortak -->
                    <Border Width="160" Height="80" Margin="0,0,10,10"
                            Background="{DynamicResource Theme.Warning.Background}" BorderBrush="{DynamicResource Theme.Warning.Border}" BorderThickness="1"
                            CornerRadius="6" Padding="12,8"
                            ToolTip="Süreci hâlâ devam eden kargolar: Teslim Edildi, Personele Teslim Edildi ve İptal dışındaki tüm kayıtlar (gelen + giden, tarih filtresi uygulanmaz).">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="CardPendingVal"
                                       Text="—" Style="{StaticResource Text.Display}"
                                       Foreground="{DynamicResource Theme.Warning.Text}"/>
                            <TextBlock Text="Toplam Bekleyen"
                                       Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Theme.Warning.Text}"/>
                        </StackPanel>
                    </Border>

                    <!-- Bildirim Bekleyen -->
                    <Border Width="160" Height="80" Margin="0,0,10,10"
                            Background="{DynamicResource Theme.Accent.Background}" BorderBrush="{DynamicResource Theme.Accent.Border}" BorderThickness="1"
                            CornerRadius="6" Padding="12,8"
                            ToolTip="Henüz WhatsApp/mail bildirimi hazırlanmamış aktif kargolar (Gönderime Hazır, Gönderildi, Teslim Alındı).">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="CardNotifPendingVal"
                                       Text="—" Style="{StaticResource Text.Display}"
                                       Foreground="{DynamicResource Theme.Accent.Text}"/>
                            <TextBlock Text="Bildirim Bekleyen"
                                       Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Theme.Accent.Text}"/>
                        </StackPanel>
                    </Border>

                    <!-- Acil Bekleyen -->
                    <Border Width="160" Height="80" Margin="0,0,10,10"
                            Background="{DynamicResource Theme.Danger.Background}" BorderBrush="{DynamicResource Theme.Danger.Border}" BorderThickness="1"
                            CornerRadius="6" Padding="12,8"
                            ToolTip="Önceliği Acil veya Çok Acil olan, teslim edilmemiş ve iptal edilmemiş kargolar.">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="CardUrgentVal"
                                       Text="—" Style="{StaticResource Text.Display}"
                                       Foreground="{DynamicResource Theme.Danger}"/>
                            <TextBlock Text="Acil Bekleyen"
                                       Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Theme.Danger.Text}"/>
                        </StackPanel>
                    </Border>

                    <!-- Bugün Teslim -->
                    <Border Width="160" Height="80" Margin="0,0,10,10"
                            Background="{DynamicResource Theme.Success.Background}" BorderBrush="{DynamicResource Theme.Success.Border}" BorderThickness="1"
                            CornerRadius="6" Padding="12,8"
                            ToolTip="Bugün 'Teslim Edildi' durumuna geçen kargolar.">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="CardTodayDeliveredVal"
                                       Text="—" Style="{StaticResource Text.Display}"
                                       Foreground="{DynamicResource Theme.Success.Text}"/>
                            <TextBlock Text="Bugün Teslim"
                                       Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Theme.Success.Text}"/>
                        </StackPanel>
                    </Border>

                </WrapPanel>

                <!-- ── Grafik satırı ─────────────────────────────── -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Grafik 1: Gelen/Giden — KATEGORİK (iki yön), mavi-turuncu -->
                    <Border Grid.Column="0" Style="{StaticResource Chart.Card}">
                        <StackPanel>
                            <TextBlock Text="Gelen / Giden (son 30 gün)"
                                       Style="{StaticResource Chart.Title}"/>
                            <lvc:CartesianChart x:Name="DirectionChart"
                                                Style="{StaticResource Chart.Cartesian}"/>
                            <TextBlock Style="{StaticResource Chart.Caption}"
                                       Text="Yön ayrımı mavi–turuncu ile yapılır; kırmızı/yeşil renk körlüğünde ayrışmaz."/>
                        </StackPanel>
                    </Border>

                    <!-- Grafik 2: Durum Dağılımı — BÜYÜKLÜK verisi, tek hue -->
                    <Border Grid.Column="2" Style="{StaticResource Chart.Card}">
                        <StackPanel>
                            <TextBlock Text="Durum Dağılımı"
                                       Style="{StaticResource Chart.Title}"/>
                            <lvc:CartesianChart x:Name="StatusChart"
                                                Style="{StaticResource Chart.Cartesian}"
                                                LegendPosition="Hidden"/>
                            <TextBlock Style="{StaticResource Chart.Caption}"
                                       Text="Tek boyutlu büyüklük: renk kimlik değil miktar taşır, çoktan aza sıralıdır."/>
                        </StackPanel>
                    </Border>

                    <!-- Grafik 3: Top 5 Kargo Firması — BÜYÜKLÜK verisi -->
                    <Border Grid.Column="4" Style="{StaticResource Chart.Card}">
                        <StackPanel>
                            <TextBlock Text="Top 5 Kargo Firması"
                                       Style="{StaticResource Chart.Title}"/>
                            <lvc:CartesianChart x:Name="CompanyChart"
                                                Style="{StaticResource Chart.Cartesian}"
                                                LegendPosition="Hidden"/>
                            <TextBlock Style="{StaticResource Chart.Caption}"
                                       Text="Beşten fazla firma varsa küçükler 'Diğer' altında toplanır."/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ── Son 10 Hareket ────────────────────────────── -->
                <TextBlock Text="Son 10 Hareket"
                           Style="{StaticResource Text.H2}" Foreground="{DynamicResource Theme.Primary}"
                           Margin="0,0,0,4"/>
                <DataGrid x:Name="RecentGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          Height="180"
                          Margin="0,0,0,14"
                          GridLinesVisibility="Horizontal"
                          AlternatingRowBackground="{DynamicResource Theme.DataGridAltRow}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Kargo No"      Binding="{Binding ShipmentNumber}"            Width="100"
                                    ElementStyle="{StaticResource EllipsisCell}"/>
                        <DataGridTextColumn Header="Yön"            Binding="{Binding DirectionDisplay}"          Width="60"
                                    ElementStyle="{StaticResource EllipsisCell}"/>
                        <DataGridTextColumn Header="Tarih"          Binding="{Binding ShipmentDate, StringFormat=dd.MM.yyyy}" Width="80"
                                    ElementStyle="{StaticResource EllipsisCell}"/>
                        <DataGridTextColumn Header="Firma/Karşı Taraf" Binding="{Binding Party}"                 Width="*"
                                    ElementStyle="{StaticResource EllipsisCell}"/>
                        <DataGridTextColumn Header="Kargo Firması"  Binding="{Binding CargoCompanyName}"         Width="120"
                                    ElementStyle="{StaticResource EllipsisCell}"/>
                        <DataGridTextColumn Header="Durum"          Binding="{Binding StatusDisplay}"            Width="100"
                                    ElementStyle="{StaticResource EllipsisCell}"/>
                        <DataGridTextColumn Header="Bildirim"       Binding="{Binding NotificationStatusDisplay}" Width="100"
                                    ElementStyle="{StaticResource EllipsisCell}"/>
                        <DataGridTextColumn Header="Öncelik"        Binding="{Binding PriorityDisplay}"          Width="70"
                                    ElementStyle="{StaticResource EllipsisCell}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Separator Margin="0,0,0,10"/>

                <!-- ── Rapor Filtreleri ──────────────────────────── -->
                <TextBlock Text="Filtrelenebilir Rapor"
                           Style="{StaticResource Text.H2}" Foreground="{DynamicResource Theme.Primary}"
                           Margin="0,0,0,6"/>

                <GroupBox Header="Filtreler" Padding="8,4,8,8" Margin="0,0,0,8">
                    <StackPanel>
                        <!-- Satır 1: tarih, yön, karşı taraf, kargo firması -->
                        <WrapPanel Orientation="Horizontal" ItemHeight="28" Margin="0,4,0,4">

                            <TextBlock Text="Başlangıç:" VerticalAlignment="Center" Margin="0,0,4,0" Width="62"/>
                            <DatePicker x:Name="DateFromPicker" Width="120" VerticalAlignment="Center" Margin="0,0,12,0"/>

                            <TextBlock Text="Bitiş:" VerticalAlignment="Center" Margin="0,0,4,0" Width="38"/>
                            <DatePicker x:Name="DateToPicker" Width="120" VerticalAlignment="Center" Margin="0,0,12,0"/>

                            <TextBlock Text="Yön:" VerticalAlignment="Center" Margin="0,0,4,0" Width="32"/>
                            <ComboBox x:Name="DirectionCombo" Width="90" VerticalAlignment="Center" Margin="0,0,12,0"/>

                            <TextBlock Text="Karşı Taraf:" VerticalAlignment="Center" Margin="0,0,4,0" Width="68"/>
                            <TextBox x:Name="KeywordBox" Width="130" VerticalAlignment="Center" Margin="0,0,12,0"
                                     Padding="3,2"/>

                            <TextBlock Text="Kargo Firması:" VerticalAlignment="Center" Margin="0,0,4,0" Width="78"/>
                            <ComboBox x:Name="CargoCompanyCombo" Width="140" VerticalAlignment="Center"/>
                        </WrapPanel>

                        <!-- Satır 2: durum, bildirim, öncelik, araç, takip, kargo no -->
                        <WrapPanel Orientation="Horizontal" ItemHeight="28" Margin="0,0,0,4">

                            <TextBlock Text="Durum:" VerticalAlignment="Center" Margin="0,0,4,0" Width="44"/>
                            <ComboBox x:Name="StatusCombo" Width="110" VerticalAlignment="Center" Margin="0,0,12,0"/>

                            <TextBlock Text="Bildirim:" VerticalAlignment="Center" Margin="0,0,4,0" Width="52"/>
                            <ComboBox x:Name="NotifStatusCombo" Width="110" VerticalAlignment="Center" Margin="0,0,12,0"/>

                            <TextBlock Text="Öncelik:" VerticalAlignment="Center" Margin="0,0,4,0" Width="52"/>
                            <ComboBox x:Name="PriorityCombo" Width="90" VerticalAlignment="Center" Margin="0,0,12,0"/>

                            <TextBlock Text="Araç Plaka:" VerticalAlignment="Center" Margin="0,0,4,0" Width="66"/>
                            <TextBox x:Name="VehiclePlateBox" Width="90" VerticalAlignment="Center" Margin="0,0,12,0"
                                     Padding="3,2"/>

                            <TextBlock Text="Takip No:" VerticalAlignment="Center" Margin="0,0,4,0" Width="58"/>
                            <TextBox x:Name="TrackingBox" Width="90" VerticalAlignment="Center" Margin="0,0,12,0"
                                     Padding="3,2"/>

                            <TextBlock Text="Kargo No:" VerticalAlignment="Center" Margin="0,0,4,0" Width="60"/>
                            <TextBox x:Name="ShipmentNoBox" Width="90" VerticalAlignment="Center" Margin="0,0,12,0"
                                     Padding="3,2"/>

                        </WrapPanel>

                        <!-- Filtre butonları -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button x:Name="FilterButton"
                                    Content="Raporu Getir"
                                    Width="110" Height="28"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="FilterButton_Click"
                                    Margin="0,0,8,0"/>
                            <Button x:Name="ClearFilterButton"
                                    Content="Filtreleri Temizle"
                                    Width="120" Height="28"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="ClearFilterButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- ── Rapor Sonuç Özeti ─────────────────────────── -->
                <Border x:Name="ReportSummaryBorder"
                        Background="{DynamicResource Theme.SurfaceAlt}" BorderBrush="{DynamicResource Theme.PrimaryHover}" BorderThickness="1"
                        CornerRadius="4" Padding="10,6" Margin="0,0,0,6"
                        Visibility="Collapsed">
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                x:Name="ExportPdfButton"
                                Content="PDF İndir"
                                Width="90" Height="26"
                                Style="{StaticResource SecondaryButton}"
                                Click="ExportPdfButton_Click"
                                Margin="8,0,0,0"/>
                        <TextBlock x:Name="ReportSummaryBlock"
                                   Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Theme.Info.Text}"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <!-- PDF başarı / hata bildirimi -->
                <Border x:Name="ExportResultBorder"
                        Background="{DynamicResource Theme.Success.Background}" BorderBrush="{DynamicResource Theme.Success.Border}" BorderThickness="1"
                        CornerRadius="4" Padding="8,5" Margin="0,0,0,6"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ExportResultBlock"
                               Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Theme.Success.Text}"/>
                </Border>

                <!-- ── Rapor Tablosu ──────────────────────────────── -->
                <DataGrid x:Name="ReportGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          Height="280"
                          GridLinesVisibility="Horizontal"
                          AlternatingRowBackground="{DynamicResource Theme.DataGridAltRow}"
                          MouseDoubleClick="ReportGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Kargo No"       Binding="{Binding ShipmentNumber}"              Width="100"
                                    ElementStyle="{StaticResource EllipsisCell}"/>
                        <DataGridTextColumn Header="Yön"             Binding="{Binding DirectionDisplay}"            Width="55"
                                    ElementStyle="{StaticResource EllipsisCell}"/>
                        <DataGridTextColumn Header="Tarih"           Binding="{Binding ShipmentDate, StringFormat=dd.MM.yyyy}" Width="75"
                                    ElementStyle="{StaticResource EllipsisCell}"/>
                        <DataGridTextColumn Header="Firma / Karşı Taraf" Binding="{Binding Party}"                  Width="*"
                                    ElementStyle="{StaticResource EllipsisCell}"/>
                        <DataGridTextColumn Header="Kargo Firması"   Binding="{Binding CargoCompanyName}"           Width="120"
                                    ElementStyle="{StaticResource EllipsisCell}"/>
                        <DataGridTextColumn Header="Takip No"        Binding="{Binding TrackingNumber}"             Width="110"
                                    ElementStyle="{StaticResource EllipsisCell}"/>
                        <DataGridTextColumn Header="Araç Plaka"      Binding="{Binding VehiclePlate}"               Width="90"
                                    ElementStyle="{StaticResource EllipsisCell}"/>
                        <DataGridTextColumn Header="Durum"           Binding="{Binding StatusDisplay}"              Width="100"
                                    ElementStyle="{StaticResource EllipsisCell}"/>
                        <DataGridTextColumn Header="Bildirim"        Binding="{Binding NotificationStatusDisplay}"  Width="100"
                                    ElementStyle="{StaticResource EllipsisCell}"/>
                        <DataGridTextColumn Header="Öncelik"         Binding="{Binding PriorityDisplay}"            Width="70"
                                    ElementStyle="{StaticResource EllipsisCell}"/>
                    </DataGrid.Columns>
                </DataGrid>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
