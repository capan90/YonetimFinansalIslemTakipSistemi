<Window x:Class="YonetimFinansalIslemTakipSistemi.UI.Views.Mail.MailContactPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rehberden Seç" Height="470" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" MinHeight="360" MinWidth="380"
        Icon="pack://application:,,,/Assets/AppIcon.ico">

    <DockPanel Margin="14">

        <TextBlock x:Name="TitleBlock"
                   DockPanel.Dock="Top"
                   FontSize="13" FontWeight="SemiBold"
                   Margin="0,0,0,8"/>

        <!-- Arama + hızlı ekleme -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button x:Name="AddContactButton"
                    DockPanel.Dock="Right"
                    Content="+ Yeni Kişi" Width="90" Height="26" Margin="6,0,0,0"
                    Padding="0" FontSize="11"
                    Style="{StaticResource SecondaryButton}"
                    Click="AddContactButton_Click"
                    ToolTip="Rehbere yeni mail kişisi ekle"/>
            <TextBox x:Name="SearchBox"
                     Height="26" VerticalContentAlignment="Center"
                     Padding="4,2" BorderThickness="1" BorderBrush="#CBD5E1"
                     TextChanged="SearchBox_TextChanged"
                     ToolTip="Ad, firma veya e-posta ile arayın"/>
        </DockPanel>

        <!-- Alt butonlar -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock x:Name="SelectionCountBlock"
                       VerticalAlignment="Center" Margin="0,0,12,0"
                       FontSize="11" Foreground="#64748B"/>
            <Button Content="Ekle" Width="90" Height="30"
                    Style="{StaticResource PrimaryButton}"
                    IsDefault="True" Click="ConfirmButton_Click"/>
            <Button Content="İptal" Width="80" Height="30" Margin="8,0,0,0"
                    Style="{StaticResource SecondaryButton}"
                    IsCancel="True"/>
        </StackPanel>

        <!-- Kişi listesi: çoklu seçim (checkbox) -->
        <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="4">
            <ListBox x:Name="ContactListBox"
                     BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  Checked="ContactCheckBox_Changed"
                                  Unchecked="ContactCheckBox_Changed"
                                  Margin="0,2">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Display}" FontSize="12"/>
                                    <!-- Varsayılan CC rozeti: bu kişinin her mailde CC'ye
                                         otomatik geldiğini seçim anında görünür kılar -->
                                    <Border Background="#EDE9FE" BorderBrush="#DDD6FE" BorderThickness="1"
                                            CornerRadius="8" Padding="5,0" Margin="6,0,0,0"
                                            Visibility="{Binding DefaultCcBadgeVisibility}">
                                        <TextBlock Text="Varsayılan CC" FontSize="9" Foreground="#6D28D9"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Email}" FontSize="10" Foreground="#64748B"/>
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

    </DockPanel>
</Window>
