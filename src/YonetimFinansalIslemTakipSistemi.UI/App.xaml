<Application x:Class="YonetimFinansalIslemTakipSistemi.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:YonetimFinansalIslemTakipSistemi.UI">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Bileşen stilleri ve converter'lar -->
                <ResourceDictionary Source="Resources/AppStyles.xaml"/>
                <!-- Kontrol kabuğu (Menu, ComboBox, Button, DatePicker...).
                     AppStyles'tan SONRA gelir: AppFocusVisual gibi ortak
                     kaynaklara DynamicResource ile başvuruyor. -->
                <ResourceDictionary Source="Resources/Controls.xaml"/>
                <!-- Rapor önizleme baskı katmanı — temadan bağımsız sabit yüzey -->
                <ResourceDictionary Source="Resources/PrintStyles.xaml"/>
                <!-- Vektör ikon geometrileri — emoji karakterlerinin yerini alır -->
                <ResourceDictionary Source="Resources/Icons.xaml"/>
                <!-- Varsayılan tema — IThemeService startup'ta kaydedilmiş temayı uygular -->
                <ResourceDictionary Source="Resources/Themes/LightTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
