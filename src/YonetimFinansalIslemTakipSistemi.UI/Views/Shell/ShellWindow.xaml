<Window x:Class="YonetimFinansalIslemTakipSistemi.UI.Views.Shell.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:common="clr-namespace:YonetimFinansalIslemTakipSistemi.UI.Common"
        Title="Yönetim"
        Height="720" Width="1280"
        MinWidth="1000" MinHeight="600"
        Icon="../../Assets/AppIcon.ico"
        WindowStartupLocation="CenterScreen">

    <!--
    TEK KABUK — FINANS PILOTU (Faz D5)

    Finans yetkili kullanici artik giristen sonra bu pencereyi goruyor;
    Nakit Islemler sekmesi acilista otomatik acilir. Kargo-only kullanici
    hala CargoDashboardWindow'a gider, "none" davranisi degismedi.

    Yerlesim:
      sol   navigasyon rayi (yalnizca TASINMIS ve YETKILI ekranlar)
      ust   sekme seridi
      orta  aktif sekmenin gorunumu
      alt   durum seridi
    Sag panel ve komut paleti bu asamada YOK.

    TASINMAMIS EKRANLAR RAYDA GORUNMEZ. CreateView'i bos olan kayit
    navigasyona hic girmez (bkz. ShellViewModel.IsVisible) — tiklaninca
    hicbir sey yapmayan sahte sekme uretilmez. Menuden acilan diger ekranlar
    su an yalnizca MainWindow uzerinden erisilebilir durumda; D6'da tasinacak.
    -->

    <!-- KISAYOLLAR: tus atamalari burada, GOVDELERI ekranda.
         Odak navigasyon rayinda ya da durum seridindeyken de calismalari
         gerekiyor; bu yuzden atama pencere seviyesinde. Komut once odaktaki
         ogeden yukselir — odak ekranin icindeyse ekran kendi
         CommandBindings'i ile isi bitirir ve pencere hic devreye girmez.
         Odak disaridaysa asagidaki Command_Forward komutu AKTIF SEKMEYE
         yonlendirir. Kabuk hangi ekranin acik oldugunu bilmez. -->
    <Window.CommandBindings>
        <CommandBinding Command="common:AppCommands.New"            Executed="Command_Forward"/>
        <CommandBinding Command="common:AppCommands.Duplicate"      Executed="Command_Forward"/>
        <CommandBinding Command="common:AppCommands.DeleteSelected" Executed="Command_Forward"/>
        <CommandBinding Command="common:AppCommands.FocusSearch"    Executed="Command_Forward"/>
        <CommandBinding Command="common:AppCommands.ImportExcel"    Executed="Command_Forward"/>
        <CommandBinding Command="common:AppCommands.RefreshList"    Executed="Command_Forward"/>
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Key="N"      Modifiers="Ctrl" Command="common:AppCommands.New"/>
        <KeyBinding Key="D"      Modifiers="Ctrl" Command="common:AppCommands.Duplicate"/>
        <KeyBinding Key="Delete"                  Command="common:AppCommands.DeleteSelected"/>
        <KeyBinding Key="F"      Modifiers="Ctrl" Command="common:AppCommands.FocusSearch"/>
        <KeyBinding Key="E"      Modifiers="Ctrl" Command="common:AppCommands.ImportExcel"/>
        <KeyBinding Key="F5"                      Command="common:AppCommands.RefreshList"/>
    </Window.InputBindings>

    <DockPanel>

        <!-- Alt durum şeridi -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource Theme.SurfaceAlt}"
                BorderBrush="{DynamicResource Theme.Border}"
                BorderThickness="0,1,0,0"
                Padding="12,5">
            <DockPanel>
                <TextBlock x:Name="StatusVersionText"
                           DockPanel.Dock="Right"
                           Style="{StaticResource Text.Caption}"/>
                <TextBlock x:Name="StatusUserText"
                           Style="{StaticResource Text.Caption}"/>
            </DockPanel>
        </Border>

        <!-- Sol navigasyon rayı -->
        <Border DockPanel.Dock="Left"
                Width="232"
                Background="{DynamicResource Theme.Nav.Background}"
                BorderBrush="{DynamicResource Theme.Border}"
                BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- Alt blok: kişisel ayar + çıkış.
                     Harf Duyarlılığı YETKİ GEREKTİRMEZ: kişisel bir tercihtir,
                     giriş yapan her kullanıcı kendi ayarını yönetir
                     (bkz. docs/03-Modules/UserSettings.md). Modal kalır —
                     sekmeye dönüştürülmedi. -->
                <StackPanel DockPanel.Dock="Bottom" Margin="10,0,10,10">
                    <TextBlock Text="Kullanıcı Ayarlarım"
                               Margin="2,0,0,4"
                               Foreground="{DynamicResource Theme.Nav.Foreground}"
                               Style="{StaticResource Text.Caption}"/>
                    <Button Content="Harf Duyarlılığı"
                            Margin="0,0,0,10"
                            HorizontalContentAlignment="Left"
                            ToolTip="Girdiğiniz metinlerin BÜYÜK/küçük harf dönüşüm tercihini belirleyin (kişisel ayar)."
                            Style="{StaticResource NavButton}"
                            Click="OpenTextCaseSettings_Click"/>
                    <Button Content="Çıkış Yap"
                            Style="{StaticResource DangerButton}"
                            Command="{Binding LogoutCommand}"/>
                </StackPanel>

                <!-- Yetkisi olmayan VEYA henüz taşınmamış öğe listeye HİÇ girmez
                     (bkz. ShellViewModel.IsVisible) -->
                <ListBox x:Name="NavigationList"
                         ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         Margin="6"
                         DisplayMemberPath="Title"
                         SelectionChanged="NavigationList_SelectionChanged"/>
            </DockPanel>
        </Border>

        <!-- Sekme şeridi + içerik.
             Margin YOK ve zemin ekranınkiyle AYNI token: kabuk ile ekran tek
             yüzey olarak okunur, iç içe kart / çift zemin oluşmaz. -->
        <TabControl x:Name="ScreenTabs"
                    ItemsSource="{Binding Tabs}"
                    SelectedItem="{Binding ActiveTab, Mode=TwoWay}">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Title}"/>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <ContentControl Content="{Binding View}"/>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>

    </DockPanel>
</Window>
