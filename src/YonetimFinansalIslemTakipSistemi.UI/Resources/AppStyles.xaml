<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:YonetimFinansalIslemTakipSistemi.UI.Converters">

    <!-- ── Converter ─────────────────────────────────────────────────────────── -->
    <converters:DecimalToColorConverter         x:Key="BalanceToColor"/>
    <converters:SystemLogLevelToColorConverter  x:Key="LevelToBackgroundConverter"/>
    <converters:SystemLogLevelToColorConverter  x:Key="LevelToForegroundConverter" />
    <converters:BoolToStatusColorConverter      x:Key="BoolToStatusColorConverter"/>

    <!-- ══ TİPOGRAFİ ÖLÇEĞİ ══════════════════════════════════════════════════
         Altı adım. XAML'de serbest FontSize yazılmaz; bu stillerden biri kullanılır.
         Boyutlar 14 taban üzerine kuruludur, satır yükseklikleri ~1.4 orandadır.

           Text.Display    28/34 Bold      dashboard hero rakamı, bakiye tutarı
           Text.H1         20/28 Bold      pencere başlığı
           Text.H2         16/24 SemiBold  bölüm / kart başlığı
           Text.Body       14/21 Regular   tablo hücresi, form etiketi  (taban)
           Text.BodyStrong 14/21 SemiBold  sütun başlığı, vurgulu gövde
           Text.Caption    12/18 Medium    kart etiketi, ipucu, zaman damgası
    ═══════════════════════════════════════════════════════════════════════ -->

    <!-- Taban font pencere seviyesinden miras alınır; alt öğeler override edebilir.
         Segoe UI Variable Text = Win11 metin optiği, Win10'da Segoe UI'ye düşer.
         Zincirin sonundaki Segoe UI Emoji, arayüzdeki emoji karakterlerinin
         kutu görünmesini engeller. -->
    <Style TargetType="{x:Type Window}">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Segoe UI Emoji"/>
        <Setter Property="FontSize"   Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
    </Style>

    <Style x:Key="Text.Display" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="28"/>
        <Setter Property="LineHeight" Value="34"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <!-- Tabular: rakam genişlikleri eşit → alt alta duran tutarların hane hizası kaymaz -->
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>

    <Style x:Key="Text.H1" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="20"/>
        <Setter Property="LineHeight" Value="28"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="Text.H2" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="16"/>
        <Setter Property="LineHeight" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="14"/>
        <Setter Property="LineHeight" Value="21"/>
    </Style>

    <Style x:Key="Text.BodyStrong" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="Text.Caption" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="12"/>
        <Setter Property="LineHeight" Value="18"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource Theme.LabelText}"/>
    </Style>

    <!-- ── Sayısal hücre ────────────────────────────────────────────────────
         Para/tutar gösteren DataGrid kolonları bunu BasedOn ile kullanır.
         Sağa hizalı + tabular rakam: hane hizası korunur, göz kolon boyunca kayar. -->
    <Style x:Key="NumericCell" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment"         Value="Right"/>
        <Setter Property="Padding"                     Value="0,0,4,0"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>

    <!-- ── Boş liste (empty state) metni ─────────────────────────────────────
         Kullanım: DataGrid'in üzerine bindirilen TextBlock bu stile BasedOn olur;
         görünürlük tetikleyicisi (Items.Count=0) ElementName gerektirdiği için
         pencere içinde tanımlanır. -->
    <Style x:Key="EmptyStateText" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment"   Value="Center"/>
        <Setter Property="Foreground"          Value="{DynamicResource Theme.MutedText}"/>
        <Setter Property="IsHitTestVisible"    Value="False"/>
        <Setter Property="Visibility"          Value="Collapsed"/>
    </Style>

    <!-- ── Odak halkası ─────────────────────────────────────────────────────
         WPF'in varsayılan noktalı odak dikdörtgeni koyu zeminde kaybolur ve
         klavyeyle gezerken nerede olunduğu anlaşılmaz. Ortak halka: 2px marka
         rengi çerçeve, kontrolün 2px dışında.
         Not: DataGridCell bilinçli olarak FocusVisualStyle={x:Null} kullanır —
         hücre bazlı halka satır seçimiyle çakışıyordu. -->
    <Style x:Key="AppFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2"
                               StrokeThickness="2"
                               Stroke="{DynamicResource Theme.PrimaryHover}"
                               RadiusX="4" RadiusY="4"
                               SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- DatePicker'ın kendi stili yoktu; odak halkası ve tema renkleri için eklendi -->
    <Style TargetType="{x:Type DatePicker}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}"/>
        <Setter Property="Background"       Value="{DynamicResource Theme.InputBackground}"/>
        <Setter Property="Foreground"       Value="{DynamicResource Theme.Text}"/>
        <Setter Property="BorderBrush"      Value="{DynamicResource Theme.InputBorder}"/>
    </Style>

    <!-- ── Sabit Renk Fırçaları (StaticResource ile referans verilen mevcut isimler) ── -->
    <!-- Not: Tema fırçaları (Theme.*) ayrı LightTheme/DarkTheme.xaml dosyalarındadır -->
    <SolidColorBrush x:Key="Brush.Primary"       Color="#1E3A5F"/>
    <SolidColorBrush x:Key="Brush.Success"       Color="#2E7D32"/>
    <SolidColorBrush x:Key="Brush.Danger"        Color="#C62828"/>
    <SolidColorBrush x:Key="Brush.Secondary"     Color="#475569"/>
    <SolidColorBrush x:Key="Brush.Disabled"      Color="#64748B"/>
    <SolidColorBrush x:Key="Brush.Border"        Color="#E2E8F0"/>
    <SolidColorBrush x:Key="Brush.GridAlt"       Color="#F8FAFC"/>
    <SolidColorBrush x:Key="Brush.GridSelected"  Color="#DBEAFE"/>
    <SolidColorBrush x:Key="Brush.GridHover"     Color="#EFF6FF"/>
    <SolidColorBrush x:Key="Brush.TextPrimary"   Color="#1A202C"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#64748B"/>

    <!-- ── Buton Stilleri ────────────────────────────────────────────────────── -->

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background"      Value="{DynamicResource Theme.Primary}"/>
        <Setter Property="Foreground"      Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Height"          Value="32"/>
        <Setter Property="Padding"         Value="14,0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="FontSize"        Value="14"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.PrimaryHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#152C4A"/>
                        </Trigger>
                        <!-- Devre dışı: #94A3B8 + Opacity 0.7 beyaz metinle 2.1:1 veriyordu.
                             Opaklık kaldırıldı, zemin koyulaştırıldı → 4.6:1 (WCAG AA). -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.DisabledBackground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Background"      Value="#475569"/>
        <Setter Property="Foreground"      Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Height"          Value="32"/>
        <Setter Property="Padding"         Value="14,0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="FontSize"        Value="14"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#334155"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1E293B"/>
                        </Trigger>
                        <!-- Devre dışı: #94A3B8 + Opacity 0.7 beyaz metinle 2.1:1 veriyordu.
                             Opaklık kaldırıldı, zemin koyulaştırıldı → 4.6:1 (WCAG AA). -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.DisabledBackground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button">
        <Setter Property="Background"      Value="#C62828"/>
        <Setter Property="Foreground"      Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Height"          Value="32"/>
        <Setter Property="Padding"         Value="14,0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="FontSize"        Value="14"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#B71C1C"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#7F1010"/>
                        </Trigger>
                        <!-- Devre dışı: #94A3B8 + Opacity 0.7 beyaz metinle 2.1:1 veriyordu.
                             Opaklık kaldırıldı, zemin koyulaştırıldı → 4.6:1 (WCAG AA). -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.DisabledBackground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── TextBox ──────────────────────────────────────────────────────────── -->
    <Style TargetType="{x:Type TextBox}">
        <Setter Property="Padding"                  Value="6,4"/>
        <Setter Property="BorderBrush"              Value="{DynamicResource Theme.InputBorder}"/>
        <Setter Property="BorderThickness"          Value="1"/>
        <Setter Property="Background"               Value="{DynamicResource Theme.InputBackground}"/>
        <Setter Property="Foreground"               Value="{DynamicResource Theme.Text}"/>
        <Setter Property="CaretBrush"               Value="{DynamicResource Theme.Text}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle"         Value="{StaticResource AppFocusVisual}"/>
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Theme.InputBorderFocus}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ── PasswordBox ──────────────────────────────────────────────────────── -->
    <Style TargetType="{x:Type PasswordBox}">
        <Setter Property="Padding"                  Value="6,4"/>
        <Setter Property="BorderBrush"              Value="{DynamicResource Theme.InputBorder}"/>
        <Setter Property="BorderThickness"          Value="1"/>
        <Setter Property="Background"               Value="{DynamicResource Theme.InputBackground}"/>
        <Setter Property="Foreground"               Value="{DynamicResource Theme.Text}"/>
        <Setter Property="CaretBrush"               Value="{DynamicResource Theme.Text}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle"         Value="{StaticResource AppFocusVisual}"/>
    </Style>

    <!-- ── ComboBox ─────────────────────────────────────────────────────────── -->
    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="Background"       Value="{DynamicResource Theme.InputBackground}"/>
        <Setter Property="Foreground"       Value="{DynamicResource Theme.Text}"/>
        <Setter Property="BorderBrush"      Value="{DynamicResource Theme.InputBorder}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}"/>
    </Style>

    <!-- ── DataGrid ──────────────────────────────────────────────────────────── -->
    <!-- SelectionUnit="FullRow": tıklamada tüm satır hücreleri seçilir.
         Seçim rengi DataGridCell trigger üzerinden uygulanır — AlternatingRowBackground
         satıra local value koyduğu için DataGridRow trigger etkisiz kalır;
         DataGridCell trigger local value taşımaz, dolayısıyla güvenilir çalışır. -->
    <Style TargetType="{x:Type DataGrid}">
        <Setter Property="HeadersVisibility"    Value="Column"/>
        <Setter Property="SelectionUnit"        Value="FullRow"/>
        <!-- 36: 14px gövde metni + rahat dokunma alanı. Tek yerden yönetilir;
             pencerelerdeki satır yüksekliği tekrarları kaldırıldı. -->
        <Setter Property="RowHeight"            Value="36"/>
        <Setter Property="FontSize"             Value="14"/>
        <Setter Property="Background"           Value="{DynamicResource Theme.DataGridRow}"/>
        <Setter Property="RowBackground"        Value="{DynamicResource Theme.DataGridRow}"/>
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource Theme.DataGridAltRow}"/>
        <Setter Property="Foreground"           Value="{DynamicResource Theme.Text}"/>
        <Setter Property="BorderBrush"          Value="{DynamicResource Theme.Border}"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Theme.Border}"/>
        <Setter Property="VerticalGridLinesBrush"   Value="{DynamicResource Theme.Border}"/>
    </Style>

    <Style TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Background"                 Value="{DynamicResource Theme.DataGridHeader}"/>
        <Setter Property="Foreground"                 Value="{DynamicResource Theme.DataGridHeaderText}"/>
        <!-- Sütun başlığı = Text.BodyStrong ile aynı ölçek (14/SemiBold) -->
        <Setter Property="FontWeight"                 Value="SemiBold"/>
        <Setter Property="FontSize"                   Value="14"/>
        <Setter Property="Padding"                    Value="8,7"/>
        <Setter Property="BorderBrush"                Value="{DynamicResource Theme.Border}"/>
        <Setter Property="BorderThickness"            Value="0,0,1,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Cursor"                     Value="Arrow"/>
    </Style>

    <Style TargetType="{x:Type DataGridRow}">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground"      Value="{DynamicResource Theme.Text}"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Theme.DataGridSelectedRow}"/>
                <Setter Property="Foreground" Value="{DynamicResource Theme.DataGridSelectedText}"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True"/>
                    <Condition Property="IsSelected"  Value="False"/>
                </MultiTrigger.Conditions>
                <MultiTrigger.Setters>
                    <Setter Property="Background" Value="{DynamicResource Theme.DataGridHoverRow}"/>
                </MultiTrigger.Setters>
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type DataGridCell}">
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground"       Value="{DynamicResource Theme.Text}"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background"  Value="{DynamicResource Theme.DataGridSelectedRow}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Foreground"  Value="{DynamicResource Theme.DataGridSelectedText}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
