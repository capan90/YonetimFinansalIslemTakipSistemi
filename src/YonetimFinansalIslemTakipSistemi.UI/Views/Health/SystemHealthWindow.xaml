        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Sistem Sağlığı"
        Width="720" Height="660"
        MinWidth="580" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Assets/AppIcon.ico"
        ResizeMode="CanResize">

    <!--
    INCE BARINDIRICI (Faz D6)

    Icerik SystemHealthScreen UserControl'une tasindi ve kabukta sekme olarak
    aciliyor. Bu pencere yalnizca baslik, boyut ve ikon tutar.

    SILINMEDI: MainWindow menuleri hala bu pencereyi aciyor ve geri donus
    yolu acik kaliyor. Is mantigi burada DEGIL - iki yerde tutulmuyor.
    -->
    <ContentControl x:Name="ScreenHost"/>

</Window>
